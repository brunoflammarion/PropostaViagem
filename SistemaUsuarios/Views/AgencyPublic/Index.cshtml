@model SistemaUsuarios.Models.ViewModels.AgencyPublicViewModel
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = Model.NomeAgencia + " — Viagens";

    var corP = Model.CorPrimaria  ?? "#005197";
    var corS = Model.CorSecundaria ?? "#4a90c4";
    var corD = Model.CorDestaque  ?? "#2ec4b6";

    var iniciais = string.IsNullOrEmpty(Model.NomeAgencia) ? "AG"
        : string.Join("", Model.NomeAgencia.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => char.ToUpper(p[0]).ToString()));

    bool temViagens  = Model.Viagens.Any();
    var origemParam  = string.IsNullOrEmpty(Model.OrigemViagem) ? "" : $"&origem={Uri.EscapeDataString(Model.OrigemViagem)}";
}

@section Styles {
<style>
:root {
    --agency-primary:   @corP;
    --agency-secondary: @corS;
    --agency-accent:    @corD;
}

* { box-sizing: border-box; }

.agency-page {
    min-height: 100vh;
    background: #f0f4f8;
    font-family: 'Inter', -apple-system, sans-serif;
}

/* ── Hero ─────────────────────────────── */
.agency-hero {
    background: linear-gradient(135deg, var(--agency-primary) 0%, color-mix(in srgb, var(--agency-primary) 70%, #000) 100%);
    color: #fff;
    padding: 2rem 1.5rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.agency-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.06)"/><circle cx="80" cy="15" r="1.5" fill="rgba(255,255,255,0.05)"/><circle cx="50" cy="70" r="1" fill="rgba(255,255,255,0.07)"/><circle cx="90" cy="60" r="1" fill="rgba(255,255,255,0.04)"/></svg>');
    pointer-events: none;
}

/* Logo da agência (marca) — não circular, proporção livre */
.agency-logo-wrap {
    position: relative; z-index: 1;
    margin: 0 auto 14px;
    display: flex; align-items: center; justify-content: center;
    max-width: 220px; max-height: 80px;
}

.agency-logo-img {
    max-width: 100%; max-height: 76px;
    width: auto; height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 4px rgba(0,0,0,.25));
}

/* Fallback tipográfico quando não há logo */
.agency-logo-fallback {
    font-size: 1.45rem; font-weight: 800;
    letter-spacing: -.02em; line-height: 1.15;
    color: #fff;
    word-break: break-word;
    max-width: 280px; text-align: center;
}

.agency-name {
    font-size: .88rem; font-weight: 600;
    opacity: .85; letter-spacing: .01em;
    margin-bottom: 2px;
    position: relative; z-index: 1;
}

.agency-tag {
    font-size: .72rem; opacity: .65;
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 20px;
    position: relative; z-index: 1;
}

.agency-hero-title {
    font-size: @(temViagens ? "1.65rem" : "2rem"); font-weight: 800;
    line-height: 1.2; margin-bottom: 10px;
    position: relative; z-index: 1;
}

.agency-hero-subtitle {
    font-size: .92rem; opacity: .88;
    max-width: 480px; margin: 0 auto 18px;
    line-height: 1.55;
    position: relative; z-index: 1;
}

.agency-hero-ctas {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 10px;
    position: relative; z-index: 1;
}

.agency-cta-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff;
    color: var(--agency-primary);
    border: none; border-radius: 50px;
    padding: 10px 22px;
    font-size: .88rem; font-weight: 700;
    cursor: pointer; text-decoration: none;
    transition: opacity .15s, transform .12s;
}

.agency-cta-primary:hover { opacity: .92; transform: translateY(-1px); color: var(--agency-primary); }

.agency-cta-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.12);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,.35); border-radius: 50px;
    padding: 10px 22px;
    font-size: .88rem; font-weight: 600;
    cursor: pointer; text-decoration: none;
    transition: background .15s, border-color .15s;
}

.agency-cta-outline:hover { background: rgba(255,255,255,.2); color: #fff; }

.agency-response-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 24px;
    padding: 5px 14px;
    font-size: .8rem; font-weight: 500;
    position: relative; z-index: 1;
    margin-top: 10px;
}

/* Bloco do consultor — integrado ao rodapé do hero */
.agency-consultant {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin-top: 22px;
    padding: 14px 20px;
    border-top: 1px solid rgba(255,255,255,.14);
    position: relative; z-index: 1;
}

/* Foto do agente (pessoa) — circular, pequena */
.agency-agent-photo {
    width: 44px; height: 44px; flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,.45);
    background: rgba(255,255,255,.15);
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; font-weight: 700; color: #fff;
}

.agency-agent-photo img { width: 100%; height: 100%; object-fit: cover; }

.agency-agent-info { text-align: left; line-height: 1.3; }

.agency-agent-name {
    display: block; font-size: .85rem; font-weight: 700;
    color: #fff;
}

.agency-agent-sub {
    display: block; font-size: .73rem;
    color: rgba(255,255,255,.7);
}

.agency-agent-wa {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; flex-shrink: 0;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50%;
    color: #fff; font-size: 1rem;
    text-decoration: none;
    transition: background .15s;
    margin-left: 4px;
}

.agency-agent-wa:hover { background: rgba(255,255,255,.28); color: #fff; }

/* ── Vitrine de viagens ───────────────── */
.agency-viagens-section {
    padding: 52px 16px 40px;
    max-width: 1100px;
    margin: 0 auto;
}

.agency-viagens-header {
    text-align: center;
    margin-bottom: 36px;
}

.agency-viagens-header h2 {
    font-size: 1.5rem; font-weight: 800;
    color: #1a2b3c; margin-bottom: 8px;
    letter-spacing: -.02em;
}

.agency-viagens-header p {
    font-size: .9rem; color: #64748b;
    max-width: 480px; margin: 0 auto;
    line-height: 1.55;
}

.agency-viagens-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

@@media (max-width: 900px) {
    .agency-viagens-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 560px) {
    .agency-viagens-grid { grid-template-columns: 1fr; }
    .agency-viagens-section { padding: 36px 14px 28px; }
}

/* Ajuste para 1-2 viagens: centralizar */
.agency-viagens-grid.count-1 { grid-template-columns: minmax(0, 420px); justify-content: center; }
.agency-viagens-grid.count-2 { grid-template-columns: repeat(2, minmax(0, 420px)); justify-content: center; }
@@media (max-width: 560px) {
    .agency-viagens-grid.count-1,
    .agency-viagens-grid.count-2 { grid-template-columns: 1fr; }
}

.viagem-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
    display: flex; flex-direction: column;
    transition: transform .18s, box-shadow .18s;
    text-decoration: none; color: inherit;
}

.viagem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(0,0,0,.13);
    color: inherit; text-decoration: none;
}

.viagem-foto {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
    background: linear-gradient(135deg, var(--agency-primary) 0%, color-mix(in srgb, var(--agency-primary) 60%, #000) 100%);
    flex-shrink: 0;
}

.viagem-foto img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
}

.viagem-foto-fallback {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    color: rgba(255,255,255,.5);
    font-size: 2.5rem;
}

.viagem-mes-badge {
    position: absolute;
    top: 12px; left: 12px;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(6px);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: .68rem; font-weight: 700;
    color: #fff; text-transform: uppercase;
    letter-spacing: .06em;
}

.viagem-body {
    padding: 16px 18px 18px;
    display: flex; flex-direction: column; flex: 1;
}

.viagem-destino {
    font-size: 1.05rem; font-weight: 800;
    color: #1a2b3c; line-height: 1.25;
    margin-bottom: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.viagem-periodo {
    font-size: .78rem; color: #64748b;
    margin-bottom: 14px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.viagem-indicadores {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: 16px;
}

.viagem-ind {
    display: inline-flex; align-items: center; gap: 5px;
    background: #f1f5f9;
    border-radius: 6px;
    padding: 4px 9px;
    font-size: .73rem; font-weight: 600;
    color: #475569;
}

.viagem-ind i { color: var(--agency-primary); font-size: .7rem; }

.viagem-explorar {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .82rem; font-weight: 700;
    color: var(--agency-primary);
    text-decoration: none;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
}

.viagem-explorar i { font-size: .72rem; transition: transform .15s; }
.viagem-card:hover .viagem-explorar i { transform: translateX(3px); }

/* ── CTA inter-seção ──────────────────── */
.agency-cta-banner {
    background: #fff;
    border-top: 1px solid #e9edf2;
    border-bottom: 1px solid #e9edf2;
    padding: 40px 20px;
    text-align: center;
}

.agency-cta-banner h3 {
    font-size: 1.2rem; font-weight: 800;
    color: #1a2b3c; margin-bottom: 8px;
}

.agency-cta-banner p {
    font-size: .88rem; color: #64748b;
    max-width: 440px; margin: 0 auto 20px;
    line-height: 1.55;
}

.agency-cta-banner-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--agency-primary);
    color: #fff;
    border: none; border-radius: 50px;
    padding: 12px 26px;
    font-size: .9rem; font-weight: 700;
    cursor: pointer; text-decoration: none;
    transition: opacity .15s, transform .12s;
}

.agency-cta-banner-btn:hover { opacity: .92; transform: translateY(-1px); color: #fff; }

/* ── Formulário ───────────────────────── */
.agency-form-wrap {
    max-width: 560px;
    margin: 0 auto;
    padding: 40px 16px 48px;
    position: relative; z-index: 2;
}

.agency-form-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0,0,0,.10);
    padding: 32px 28px;
}

.agency-form-title {
    font-size: 1.05rem; font-weight: 700;
    color: #1a2b3c;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f0f0f0;
}

.agency-label {
    font-size: .8rem; font-weight: 600;
    color: #374151; margin-bottom: 5px;
    display: block;
}

.agency-input {
    width: 100%;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 13px;
    font-size: .9rem;
    font-family: 'Inter', sans-serif;
    color: #1a2b3c;
    transition: border-color .15s, box-shadow .15s;
    outline: none;
}

.agency-input:focus {
    border-color: var(--agency-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--agency-primary) 15%, transparent);
}

.agency-input::placeholder { color: #9ca3af; }

.agency-input-group { margin-bottom: 18px; }

.agency-submit-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--agency-primary), color-mix(in srgb, var(--agency-primary) 80%, var(--agency-accent)));
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 14px;
    font-size: 1rem; font-weight: 700;
    cursor: pointer;
    transition: opacity .2s, transform .15s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 8px;
}

.agency-submit-btn:hover { opacity: .92; transform: translateY(-1px); }
.agency-submit-btn:active { transform: translateY(0); }

/* ── Sucesso ──────────────────────────── */
.agency-success { text-align: center; padding: 32px 20px; }

.agency-success-icon {
    width: 72px; height: 72px; border-radius: 50%;
    background: linear-gradient(135deg, #16db93, #13c87f);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; color: #fff;
    margin: 0 auto 20px;
    box-shadow: 0 4px 16px rgba(22,219,147,.35);
}

.agency-success h4 { font-size: 1.2rem; font-weight: 700; color: #1a2b3c; margin-bottom: 10px; }
.agency-success p  { font-size: .92rem; color: #6b7a8d; margin-bottom: 8px; line-height: 1.55; }

/* ── Inativa ──────────────────────────── */
.agency-inactive { text-align: center; padding: 32px 20px; }
.agency-inactive-icon { font-size: 3rem; color: #d1d5db; margin-bottom: 20px; display: block; }

/* ── Footer ───────────────────────────── */
.agency-footer {
    text-align: center; padding: 24px 16px;
    font-size: .74rem; color: #9ca3af;
    background: #f0f4f8;
}

.agency-footer a { color: #9ca3af; text-decoration: none; }
.agency-footer a:hover { color: #6b7a8d; }

/* ── Mobile hero adjustments ─────────── */
@@media (max-width: 480px) {
    .agency-hero-title { font-size: 1.45rem; }
    .agency-hero-subtitle { font-size: .87rem; }
    .agency-form-card { padding: 24px 16px; }
    .agency-cta-banner { padding: 28px 16px; }
    .agency-cta-banner h3 { font-size: 1.05rem; }
}
</style>
}

<div class="agency-page">

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <div class="agency-hero" id="topo">
        @{
            bool temLogo  = !string.IsNullOrEmpty(Model.LogoAgenciaPath);
            bool temFoto  = !string.IsNullOrEmpty(Model.FotoPath);
            bool temAgente = !string.IsNullOrEmpty(Model.NomeAgente);

            var iniciaisAgente = !string.IsNullOrEmpty(Model.NomeAgente)
                ? string.Join("", Model.NomeAgente.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(p => char.ToUpper(p[0]).ToString()))
                : iniciais;

            var waUrl = WhatsAppHelper.MontarUrl(
                Model.TelefoneAgente,
                $"Olá! Vi a página da {Model.NomeAgencia} e gostaria de mais informações sobre viagens.");

            bool mostrarConsultor = temAgente || temFoto;
        }

        <!-- 1. Logo da agência (marca) — não circular, proporção livre -->
        <div class="agency-logo-wrap">
            @if (temLogo)
            {
                <img class="agency-logo-img" src="@Model.LogoAgenciaPath" alt="@Model.NomeAgencia" />
            }
            else
            {
                <div class="agency-logo-fallback">@Model.NomeAgencia</div>
            }
        </div>

        <!-- 2. Nome da agência abaixo da logo (omitido no fallback tipográfico para não repetir) -->
        @if (temLogo)
        {
            <div class="agency-name">@Model.NomeAgencia</div>
        }
        <div class="agency-tag">Agência de Viagens</div>

        <!-- 3. Headline -->
        <h1 class="agency-hero-title">
            @if (!string.IsNullOrEmpty(Model.WelcomeMessage))
            {
                @Model.WelcomeMessage
            }
            else
            {
                <text>Sua próxima viagem<br>começa aqui</text>
            }
        </h1>

        <!-- 4. Subtítulo -->
        @if (temViagens)
        {
            <p class="agency-hero-subtitle">Pacotes selecionados pela nossa agência ou uma viagem criada especialmente para você.</p>
        }
        else
        {
            <p class="agency-hero-subtitle">Preencha o formulário e entraremos em contato para criar uma proposta personalizada para você.</p>
        }

        <!-- 5. Badge de tempo de resposta -->
        @if (!string.IsNullOrEmpty(Model.ResponseTimeText))
        {
            <div class="agency-response-badge">
                <i class="fas fa-clock"></i>
                Resposta em até @Model.ResponseTimeText
            </div>
        }

        <!-- 6. CTAs principais -->
        @if (temViagens)
        {
            <div class="agency-hero-ctas" style="margin-top:16px;">
                <a href="#viagens" class="agency-cta-primary" onclick="scrollSmooth('viagens',event)">
                    <i class="fas fa-compass"></i>Ver viagens
                </a>
                <a href="#formulario" class="agency-cta-outline" onclick="scrollSmooth('formulario',event)">
                    <i class="fas fa-paper-plane"></i>Planejar minha viagem
                </a>
            </div>
        }

        <!-- 7. Bloco do consultor — foto do agente (pessoa), não logo -->
        @if (mostrarConsultor)
        {
            <div class="agency-consultant">
                <div class="agency-agent-photo">
                    @if (temFoto)
                    {
                        <img src="@Model.FotoPath" alt="@Model.NomeAgente" />
                    }
                    else
                    {
                        @iniciaisAgente
                    }
                </div>
                <div class="agency-agent-info">
                    @if (temAgente)
                    {
                        <span class="agency-agent-name">@Model.NomeAgente</span>
                    }
                    <span class="agency-agent-sub">Seu consultor de viagens</span>
                </div>
                @if (waUrl != null)
                {
                    <a href="@waUrl" target="_blank" rel="noopener noreferrer"
                       class="agency-agent-wa" title="Chamar no WhatsApp">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- ── Vitrine de viagens ─────────────────────────────────── -->
    @if (temViagens)
    {
        <section class="agency-viagens-section" id="viagens">
            <div class="agency-viagens-header">
                <h2>Inspire-se para sua próxima viagem</h2>
                <p>Roteiros selecionados pela nossa agência para você viver novas experiências.</p>
            </div>

            @{
                var countClass = Model.Viagens.Count == 1 ? "count-1"
                               : Model.Viagens.Count == 2 ? "count-2"
                               : "";
            }
            <div class="agency-viagens-grid @countClass">
                @foreach (var v in Model.Viagens)
                {
                    var destTitulo  = v.DestinosPrincipal.Length > 0 ? v.DestinosPrincipal : v.Titulo;
                    var periodoStr  = "";
                    if (v.DataInicio.HasValue && v.DataFim.HasValue)
                    {
                        var noites = v.DuracaoNoites ?? 0;
                        periodoStr = $"{v.DataInicio.Value:dd/MM/yyyy} · {noites} {(noites == 1 ? "noite" : "noites")}";
                    }
                    else if (v.DataInicio.HasValue)
                    {
                        periodoStr = $"A partir de {v.DataInicio.Value:dd/MM/yyyy}";
                    }

                    <a href="/Proposta/Publico/@v.Id" class="viagem-card">
                        <div class="viagem-foto">
                            @if (!string.IsNullOrEmpty(v.FotoCapa))
                            {
                                <img src="@v.FotoCapa" alt="@destTitulo" loading="lazy" />
                            }
                            else
                            {
                                <div class="viagem-foto-fallback">
                                    <i class="fas fa-globe-americas"></i>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(v.MesAno))
                            {
                                <span class="viagem-mes-badge">@v.MesAno</span>
                            }
                        </div>

                        <div class="viagem-body">
                            <div class="viagem-destino">@destTitulo</div>
                            @if (!string.IsNullOrEmpty(periodoStr))
                            {
                                <div class="viagem-periodo">@periodoStr</div>
                            }

                            <div class="viagem-indicadores">
                                @if (v.TemVoo)         { <span class="viagem-ind"><i class="fas fa-plane"></i>Aéreo</span> }
                                @if (v.TemHospedagem)  { <span class="viagem-ind"><i class="fas fa-hotel"></i>Hospedagem</span> }
                                @if (v.TemExperiencia) { <span class="viagem-ind"><i class="fas fa-star"></i>Experiências</span> }
                                @if (v.TemTransporte)  { <span class="viagem-ind"><i class="fas fa-shuttle-van"></i>Transporte</span> }
                            </div>

                            <span class="viagem-explorar">
                                Explorar viagem <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </section>

        <!-- CTA entre vitrine e formulário -->
        <div class="agency-cta-banner">
            <h3>Não encontrou exatamente o que procura?</h3>
            <p>Cada viagem pode ser única. Conte para nós o que você está planejando e preparamos uma proposta personalizada para você.</p>
            <a href="#formulario" class="agency-cta-banner-btn" onclick="scrollSmooth('formulario',event)">
                <i class="fas fa-paper-plane"></i>
                Planejar minha viagem
            </a>
        </div>
    }

    <!-- ── Formulário / Estado ───────────────────────────────── -->
    <div class="agency-form-wrap" id="formulario">
        <div class="agency-form-card">

            @if (Model.Enviado)
            {
                <!-- Sucesso -->
                <div class="agency-success">
                    <div class="agency-success-icon"><i class="fas fa-check"></i></div>
                    <h4>Recebemos sua solicitação!</h4>
                    <p>Em breve entraremos em contato para planejar sua viagem.</p>
                    @if (!string.IsNullOrEmpty(Model.ResponseTimeText))
                    {
                        <p><strong>Tempo estimado de resposta: @Model.ResponseTimeText</strong></p>
                    }
                    <a href="/@Model.SlugAgencia" class="btn btn-outline-secondary btn-sm mt-3">
                        <i class="fas fa-redo me-1"></i>Enviar nova solicitação
                    </a>
                </div>
            }
            else if (!Model.CaptacaoAtiva)
            {
                <!-- Inativa -->
                <div class="agency-inactive">
                    <i class="fas fa-pause-circle agency-inactive-icon"></i>
                    <h5 style="color:#374151;font-weight:700;">Temporariamente indisponível</h5>
                    <p class="text-muted mt-2" style="font-size:.9rem;">
                        Esta agência não está recebendo novas solicitações no momento.
                        <br>Tente novamente mais tarde.
                    </p>
                </div>
            }
            else
            {
                <!-- Erro de envio -->
                @if (!string.IsNullOrEmpty(Model.ErroEnvio))
                {
                    <div class="alert alert-danger rounded-3 mb-4" style="font-size:.88rem;">
                        <i class="fas fa-exclamation-circle me-2"></i>@Model.ErroEnvio
                    </div>
                }

                <div class="agency-form-title">
                    <i class="fas fa-plane-departure me-2" style="color:@corD;"></i>Sua solicitação de viagem
                </div>

                <form asp-controller="AgencyPublic" asp-action="Index"
                      asp-route-agencySlug="@Model.SlugAgencia"
                      method="post">
                    @Html.AntiForgeryToken()
                    <!-- Origem da viagem (quando o visitante veio de uma viagem Site) -->
                    <input type="hidden" name="origemViagem" value="@Model.OrigemViagem" />

                    <!-- Campos obrigatórios -->
                    <div class="agency-input-group">
                        <label class="agency-label" for="fullName">Nome completo <span style="color:#dc3545;">*</span></label>
                        <input class="agency-input" type="text" id="fullName" name="fullName"
                               maxlength="200" required placeholder="Seu nome completo" autocomplete="name" />
                    </div>

                    <div class="agency-input-group">
                        <label class="agency-label" for="whatsApp">WhatsApp <span style="color:#dc3545;">*</span></label>
                        <input class="agency-input" type="tel" id="whatsApp" name="whatsApp"
                               maxlength="20" required placeholder="(11) 99999-9999" autocomplete="tel" />
                    </div>

                    <div class="agency-input-group">
                        <label class="agency-label" for="destination">Destino desejado <span style="color:#dc3545;">*</span></label>
                        <input class="agency-input" type="text" id="destination" name="destination"
                               maxlength="300" required placeholder="Ex: Paris, Grécia, Disney..."
                               value="@(string.IsNullOrEmpty(Model.OrigemViagem) ? "" : Model.OrigemViagem)" />
                    </div>

                    <!-- Campos opcionais configurados -->
                    @if (Model.ShowEmail)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="email">E-mail</label>
                            <input class="agency-input" type="email" id="email" name="email"
                                   maxlength="150" placeholder="seu@email.com" autocomplete="email" />
                        </div>
                    }

                    @if (Model.ShowOriginCity)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="originCity">Cidade de origem</label>
                            <input class="agency-input" type="text" id="originCity" name="originCity"
                                   maxlength="150" placeholder="De onde você vai partir?" />
                        </div>
                    }

                    @if (Model.ShowTravelDates)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="travelDates">Datas previstas da viagem</label>
                            <input class="agency-input" type="text" id="travelDates" name="travelDates"
                                   maxlength="100" placeholder="Ex: 15/01 a 25/01/2026" />
                        </div>
                    }

                    @if (Model.ShowAdults || Model.ShowChildren)
                    {
                        <div class="row g-3 mb-0">
                            @if (Model.ShowAdults)
                            {
                                <div class="col-6">
                                    <div class="agency-input-group">
                                        <label class="agency-label" for="adults">Adultos</label>
                                        <input class="agency-input" type="number" id="adults" name="adults"
                                               min="1" max="20" placeholder="1" style="padding:10px 13px;" />
                                    </div>
                                </div>
                            }
                            @if (Model.ShowChildren)
                            {
                                <div class="col-6">
                                    <div class="agency-input-group">
                                        <label class="agency-label" for="children">Crianças</label>
                                        <input class="agency-input" type="number" id="children" name="children"
                                               min="0" max="20" placeholder="0" style="padding:10px 13px;" />
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (Model.ShowBudget)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="budget">Orçamento estimado</label>
                            <input class="agency-input" type="text" id="budget" name="budget"
                                   maxlength="100" placeholder="Ex: R$ 5.000 por pessoa" />
                        </div>
                    }

                    @if (Model.ShowTripType)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="tripType">Tipo de viagem</label>
                            <select class="agency-input" id="tripType" name="tripType">
                                <option value="">Selecione...</option>
                                <option>Casal / Lua de mel</option>
                                <option>Família</option>
                                <option>Grupo de amigos</option>
                                <option>Viagem solo</option>
                                <option>Viagem corporativa</option>
                                <option>Outro</option>
                            </select>
                        </div>
                    }

                    @if (Model.ShowAccommodationPreference)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="accommodationPreference">Preferência de hospedagem</label>
                            <select class="agency-input" id="accommodationPreference" name="accommodationPreference">
                                <option value="">Selecione...</option>
                                <option>Hotel econômico</option>
                                <option>Hotel intermediário</option>
                                <option>Hotel superior / 4 estrelas</option>
                                <option>Hotel de luxo / 5 estrelas</option>
                                <option>Resort</option>
                                <option>Pousada / Boutique</option>
                                <option>Sem preferência</option>
                            </select>
                        </div>
                    }

                    @if (Model.ShowBestContactTime)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="bestContactTime">Melhor horário para contato</label>
                            <input class="agency-input" type="text" id="bestContactTime" name="bestContactTime"
                                   maxlength="100" placeholder="Ex: Manhã, após 18h, qualquer horário..." />
                        </div>
                    }

                    @if (Model.ShowNotes)
                    {
                        <div class="agency-input-group">
                            <label class="agency-label" for="notes">Observações adicionais</label>
                            <textarea class="agency-input" id="notes" name="notes"
                                      maxlength="1000" rows="3"
                                      placeholder="Conte mais sobre o que você está imaginando para essa viagem..."
                                      style="resize:vertical;"></textarea>
                        </div>
                    }

                    <button type="submit" class="agency-submit-btn">
                        <i class="fas fa-paper-plane"></i>
                        Quero minha cotação
                    </button>

                    <p class="text-center mt-3 mb-0" style="font-size:.75rem;color:#9ca3af;">
                        <i class="fas fa-shield-alt me-1"></i>
                        Seus dados são usados apenas para preparar sua proposta de viagem.
                    </p>
                </form>
            }

        </div>
    </div>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <div class="agency-footer">
        Página criada com <strong>AgentTools</strong> · <a href="/" target="_blank">agenttools.com.br</a>
    </div>

</div>

@section Scripts {
<script>
function scrollSmooth(id, e) {
    if (e) e.preventDefault();
    var el = document.getElementById(id);
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Scroll automático para o formulário se veio de uma viagem (origemViagem preenchida)
(function () {
    var origem = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.OrigemViagem ?? ""))';
    if (origem) {
        setTimeout(function () {
            var form = document.getElementById('formulario');
            if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 600);
    }
})();
</script>
}
