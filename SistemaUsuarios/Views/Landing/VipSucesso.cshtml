@{
    Layout = null;
    ViewData["Title"] = "Cadastro realizado — Agent Tools";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"]</title>
<meta name="robots" content="noindex">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,Helvetica,Arial,sans-serif;color:#1A1F2E;background:#0A1F3D;-webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100vh}
a{text-decoration:none;color:inherit}

:root{
  --night:#0A1F3D;
  --blue:#1E5BA8;
  --sky:#5BA8FF;
  --sand:#FBFAF7;
  --ink:#1A1F2E;
  --gold:#D4952A;
  --w:#ffffff;
  --r10:10px;--r14:14px;--r20:20px;--rpill:999px;
}

/* NAV */
nav.top{height:64px;display:flex;align-items:center;padding:0 24px;border-bottom:1px solid rgba(255,255,255,.07)}
.nav-i{width:100%;max-width:1120px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}
.nav-logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;color:#fff;letter-spacing:-.3px}
.logo-img{width:28px;height:28px;filter:brightness(0) invert(1);opacity:.85;display:block;flex-shrink:0}
.nav-back{font-size:13px;color:rgba(255,255,255,.45);display:flex;align-items:center;gap:6px;transition:color .2s}
.nav-back:hover{color:rgba(255,255,255,.75)}
.nav-back svg{width:14px;height:14px}

/* HERO */
.hero{background:var(--night);padding:64px 24px 56px;position:relative;overflow:hidden;text-align:center}
.hero::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:900px;height:600px;background:radial-gradient(ellipse at 50% 0%,rgba(91,168,255,.12) 0%,transparent 65%);pointer-events:none}
.hero-inner{max-width:640px;margin:0 auto;position:relative;z-index:1}

/* PROGRESS */
.progress{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:40px}
.step{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.02em;color:rgba(255,255,255,.4)}
.step.done{color:rgba(91,168,255,.9)}
.step.active{color:#fff}
.step-num{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;border:1.5px solid currentColor}
.step.done .step-num{background:rgba(91,168,255,.18);border-color:rgba(91,168,255,.6)}
.step.active .step-num{background:var(--blue);border-color:var(--blue);color:#fff}
.step-label{white-space:nowrap}
@@media(max-width:400px){.step-label{display:none}}
.step-sep{width:28px;height:1.5px;background:rgba(255,255,255,.12);margin:0 4px;flex-shrink:0}
.step.done + .step-sep{background:rgba(91,168,255,.35)}

/* BADGE */
.confirm-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(91,168,255,.1);border:1px solid rgba(91,168,255,.25);color:var(--sky);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:6px 16px;border-radius:var(--rpill);margin-bottom:28px}
.badge-dot{width:6px;height:6px;border-radius:50%;background:#4ADE80;animation:blink 2s ease infinite}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}

h1.title{font-size:clamp(36px,7vw,52px);font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#fff;margin-bottom:18px;text-wrap:balance}
h1.title span{color:var(--sky)}
.subtitle{font-size:17px;line-height:1.65;color:rgba(255,255,255,.58);max-width:480px;margin:0 auto 16px;text-wrap:balance}
.next-step-text{font-size:15px;font-weight:600;color:rgba(255,255,255,.82);max-width:460px;margin:0 auto}

/* MAIN CONTENT */
.main{background:var(--sand);padding:64px 24px 80px}
.main-inner{max-width:680px;margin:0 auto}

/* SECTION LABEL */
.sec-label{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);margin-bottom:24px}

/* CHANNELS */
.channels{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:48px}
@@media(max-width:580px){.channels{grid-template-columns:1fr}}

.channel-card{background:#fff;border-radius:var(--r20);border:1px solid #E5E0D8;padding:28px 24px 24px;display:flex;flex-direction:column;gap:0;box-shadow:0 4px 20px rgba(0,0,0,.06),0 1px 3px rgba(0,0,0,.04);transition:transform .2s,box-shadow .2s}
.channel-card:hover{transform:translateY(-3px);box-shadow:0 8px 32px rgba(0,0,0,.1),0 1px 3px rgba(0,0,0,.04)}
.ch-icon{width:48px;height:48px;border-radius:var(--r14);display:flex;align-items:center;justify-content:center;margin-bottom:16px;flex-shrink:0}
.ch-icon.wpp{background:rgba(37,211,102,.12)}
.ch-icon.ig{background:rgba(214,48,164,.1)}
.ch-icon svg{width:26px;height:26px}
.ch-title{font-size:17px;font-weight:800;color:var(--ink);letter-spacing:-.3px;margin-bottom:8px;line-height:1.25}
.ch-desc{font-size:14px;line-height:1.65;color:#5A6580;margin-bottom:8px}
.ch-list{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:5px}
.ch-list li{font-size:13px;color:#5A6580;display:flex;align-items:baseline;gap:7px}
.ch-list li::before{content:'→';color:var(--blue);font-weight:700;flex-shrink:0;font-size:12px}
.ch-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border-radius:var(--r10);font-size:14px;font-weight:700;transition:transform .15s,box-shadow .15s;margin-top:auto}
.ch-btn:hover{transform:translateY(-1px)}
.ch-btn.wpp{background:#25D366;color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.35)}
.ch-btn.wpp:hover{box-shadow:0 6px 20px rgba(37,211,102,.45)}
.ch-btn.ig{background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff;box-shadow:0 4px 14px rgba(220,39,67,.25)}
.ch-btn.ig:hover{box-shadow:0 6px 20px rgba(220,39,67,.35)}
.ch-btn svg{width:16px;height:16px}

/* BENEFITS */
.benefits-box{background:#fff;border-radius:var(--r20);border:1px solid #E5E0D8;padding:28px 28px 24px;margin-bottom:48px;box-shadow:0 2px 12px rgba(0,0,0,.04)}
.benefits-header{display:flex;align-items:center;gap:10px;margin-bottom:18px}
.benefits-icon{width:36px;height:36px;border-radius:var(--r10);background:rgba(212,149,42,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.benefits-icon svg{width:18px;height:18px;color:var(--gold)}
.benefits-title{font-size:15px;font-weight:800;color:var(--ink);letter-spacing:-.2px}
.benefits-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@@media(max-width:480px){.benefits-grid{grid-template-columns:1fr}}
.benefit-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--sand);border-radius:var(--r10)}
.benefit-check{width:20px;height:20px;border-radius:50%;background:rgba(30,91,168,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.benefit-check svg{width:11px;height:11px;color:var(--blue)}
.benefit-text{font-size:13px;color:var(--ink);font-weight:500;line-height:1.4}

/* CLOSING */
.closing{background:var(--night);border-radius:var(--r20);padding:36px 32px;text-align:center;position:relative;overflow:hidden}
.closing::before{content:'';position:absolute;top:-60px;right:-60px;width:260px;height:260px;background:radial-gradient(circle,rgba(91,168,255,.1) 0%,transparent 65%);pointer-events:none}
.closing-icon{width:52px;height:52px;margin:0 auto 18px;background:rgba(91,168,255,.12);border-radius:50%;display:flex;align-items:center;justify-content:center}
.closing-icon svg{width:26px;height:26px;color:var(--sky)}
.closing h2{font-size:22px;font-weight:800;color:#fff;letter-spacing:-.4px;margin-bottom:12px;text-wrap:balance}
.closing p{font-size:15px;line-height:1.7;color:rgba(255,255,255,.55);max-width:440px;margin:0 auto 8px;text-wrap:balance}
.closing p+p{margin-top:10px}

/* FOOTER */
footer{background:var(--night);border-top:1px solid rgba(255,255,255,.06);padding:24px}
.foot-i{max-width:680px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.foot-logo{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:rgba(255,255,255,.5)}
.foot-logo img{width:20px;height:20px;filter:brightness(0) invert(1);opacity:.4}
.foot-copy{font-size:12px;color:rgba(255,255,255,.25)}
.foot-back{font-size:13px;color:rgba(255,255,255,.35);transition:color .2s}
.foot-back:hover{color:rgba(255,255,255,.65)}
</style>
</head>
<body>

<!-- NAV -->
<nav class="top">
  <div class="nav-i">
    <div class="nav-logo">
      <img src="~/images/logo.png" alt="" class="logo-img">
      Agent Tools
    </div>
    <a href="/" class="nav-back">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 12L6 8l4-4"/></svg>
      Voltar à página inicial
    </a>
  </div>
</nav>

<!-- HERO SECTION -->
<section class="hero">
  <div class="hero-inner">

    <!-- Progress indicator -->
    <div class="progress">
      <div class="step done">
        <div class="step-num">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2,6 5,9 10,3"/></svg>
        </div>
        <span class="step-label">Cadastro</span>
      </div>
      <div class="step-sep"></div>
      <div class="step active">
        <div class="step-num">2</div>
        <span class="step-label">Canais</span>
      </div>
      <div class="step-sep"></div>
      <div class="step">
        <div class="step-num">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1l.5 3.5L10 6l-3.5.5L6 11l-.5-3.5L2 6l3.5-.5z"/></svg>
        </div>
        <span class="step-label">Lançamento</span>
      </div>
    </div>

    <div class="confirm-badge">
      <span class="badge-dot"></span>
      Cadastro confirmado
    </div>

    <h1 class="title">🎉 <span>Vaga reservada</span> na Lista VIP!</h1>
    <p class="subtitle">Você será um dos primeiros agentes a conhecer a plataforma. Receberá informações antecipadas, materiais exclusivos e condições especiais de lançamento.</p>
    <p class="next-step-text">Agora falta apenas um último passo para garantir que você não perca nenhuma novidade.</p>

  </div>
</section>

<!-- MAIN CONTENT -->
<div class="main">
  <div class="main-inner">

    <p class="sec-label">Último passo recomendado — conecte-se aos canais oficiais</p>

    <!-- CHANNEL CARDS -->
    <div class="channels">

      <!-- WhatsApp -->
      <div class="channel-card">
        <div class="ch-icon wpp">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M20.52 3.48A11.93 11.93 0 0012 0C5.37 0 0 5.37 0 12c0 2.11.55 4.17 1.6 5.99L0 24l6.22-1.63A11.94 11.94 0 0012 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.22-3.48-8.52z" fill="#25D366"/>
            <path d="M17.47 14.53c-.27-.13-1.6-.79-1.85-.88-.25-.09-.43-.13-.61.13-.18.27-.69.88-.85 1.06-.16.18-.32.2-.59.07-.27-.13-1.14-.42-2.17-1.34-.8-.71-1.34-1.59-1.5-1.86-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.48-.07-.13-.61-1.47-.84-2.01-.22-.53-.45-.46-.61-.46-.16 0-.34-.02-.52-.02-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.28s.98 2.65 1.12 2.83c.13.18 1.93 2.95 4.68 4.14.65.28 1.16.45 1.56.58.65.21 1.24.18 1.71.11.52-.08 1.6-.65 1.82-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32z" fill="#fff"/>
          </svg>
        </div>
        <h3 class="ch-title">Canal Oficial do WhatsApp</h3>
        <p class="ch-desc">É por lá que avisaremos primeiro sobre:</p>
        <ul class="ch-list">
          <li>Novidades do desenvolvimento</li>
          <li>Novas funcionalidades</li>
          <li>Lançamento oficial</li>
          <li>Benefícios exclusivos da Lista VIP</li>
        </ul>
        <a href="https://whatsapp.com/channel/0029VbCyZQHKWEKwYyXz2k0u" target="_blank" rel="noopener" class="ch-btn wpp">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.93 11.93 0 0012 0C5.37 0 0 5.37 0 12c0 2.11.55 4.17 1.6 5.99L0 24l6.22-1.63A11.94 11.94 0 0012 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.22-3.48-8.52z"/></svg>
          Entrar no Canal do WhatsApp
        </a>
      </div>

      <!-- Instagram -->
      <div class="channel-card">
        <div class="ch-icon ig">
          <svg viewBox="0 0 24 24" fill="none">
            <defs>
              <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#f09433"/>
                <stop offset="25%" stop-color="#e6683c"/>
                <stop offset="50%" stop-color="#dc2743"/>
                <stop offset="75%" stop-color="#cc2366"/>
                <stop offset="100%" stop-color="#bc1888"/>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#ig-grad)"/>
            <circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8" fill="none"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="#fff"/>
          </svg>
        </div>
        <h3 class="ch-title">Agent Tools no Instagram</h3>
        <p class="ch-desc">Publicaremos conteúdo exclusivo para você acompanhar a evolução da plataforma:</p>
        <ul class="ch-list">
          <li>Demonstrações da plataforma</li>
          <li>Dicas para agentes de viagens</li>
          <li>Bastidores do desenvolvimento</li>
          <li>Novidades e próximos passos</li>
        </ul>
        <a href="https://www.instagram.com/agenttools_/" target="_blank" rel="noopener" class="ch-btn ig">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="6"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
          Seguir @@agenttools_
        </a>
      </div>

    </div>

    <!-- BENEFITS -->
    <div class="benefits-box">
      <div class="benefits-header">
        <div class="benefits-icon">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" color="#D4952A"><path d="M9 1l2 5h5l-4 3 1.5 5L9 11l-4.5 3L6 9 2 6h5z"/></svg>
        </div>
        <p class="benefits-title">🎁 Benefícios para quem faz parte da Lista VIP</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-item">
          <div class="benefit-check">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2,6 5,9 10,3"/></svg>
          </div>
          <span class="benefit-text">Desconto exclusivo de lançamento</span>
        </div>
        <div class="benefit-item">
          <div class="benefit-check">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2,6 5,9 10,3"/></svg>
          </div>
          <span class="benefit-text">Acesso antecipado à plataforma</span>
        </div>
        <div class="benefit-item">
          <div class="benefit-check">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2,6 5,9 10,3"/></svg>
          </div>
          <span class="benefit-text">Participação nas evoluções do produto</span>
        </div>
        <div class="benefit-item">
          <div class="benefit-check">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2,6 5,9 10,3"/></svg>
          </div>
          <span class="benefit-text">Conteúdo exclusivo antes do lançamento</span>
        </div>
      </div>
    </div>

    <!-- CLOSING -->
    <div class="closing">
      <div class="closing-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z"/></svg>
      </div>
      <h2>Nos vemos em breve!</h2>
      <p>Estamos trabalhando para entregar uma plataforma que transforme a forma como agentes de viagens criam propostas.</p>
      <p style="color:rgba(255,255,255,.38);font-size:14px">Obrigado por fazer parte dos primeiros agentes que acreditaram no Agent Tools.</p>
    </div>

  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="foot-i">
    <div class="foot-logo">
      <img src="~/images/logo.png" alt="" width="20" height="20">
      Agent Tools
    </div>
    <span class="foot-copy">&copy; 2026 Agent Tools. Todos os direitos reservados.</span>
    <a href="/" class="foot-back">← Página inicial</a>
  </div>
</footer>

</body>
</html>
