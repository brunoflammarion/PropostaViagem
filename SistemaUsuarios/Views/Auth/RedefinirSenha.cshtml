@{
    ViewData["Title"] = "Nova senha";
    Layout = "_LayoutLanding";
}

@section Styles {
<style>
body { background: #F3F6FB; min-height: 100vh; margin: 0; padding: 0; }

.auth-shell {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
}

.auth-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 32px rgba(10,31,61,.10);
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 420px;
}

.auth-card-header { margin-bottom: 1.75rem; }
.auth-card-header h1 {
    font-size: 1.55rem;
    font-weight: 700;
    color: #1A1F2E;
    letter-spacing: -.03em;
    margin: 0 0 .35rem;
}
.auth-card-header p { font-size: .85rem; color: #68728B; margin: 0; }

.auth-alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: .875rem;
    margin-bottom: 1.25rem;
    line-height: 1.5;
}
.auth-alert-danger {
    background: #FFF1F2;
    border: 1px solid #FDA4AF;
    color: #9F1239;
}
.auth-alert i { margin-top: 2px; flex-shrink: 0; }

.auth-form .form-label {
    font-size: .8rem;
    font-weight: 600;
    color: #002B45;
    margin-bottom: .35rem;
}
.auth-form .input-group-text {
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-right: none;
    color: #94a3b8;
    font-size: .85rem;
    border-radius: 10px 0 0 10px !important;
}
.auth-form .form-control {
    border: 1.5px solid #E2E8F0;
    border-left: none;
    background: #F8FAFC;
    font-size: .875rem;
    color: #002B45;
    padding: .6rem .85rem;
    border-radius: 0 10px 10px 0 !important;
    transition: border-color .15s, box-shadow .15s;
}
.auth-form .form-control:focus {
    border-color: #5BA8FF;
    box-shadow: 0 0 0 3px rgba(91,168,255,.16);
    background: #fff;
    outline: none;
}
.auth-form .input-group:focus-within .input-group-text {
    border-color: #5BA8FF;
    background: #fff;
}
.auth-submit {
    display: block;
    width: 100%;
    padding: .75rem;
    background: linear-gradient(90deg, #1E4E8C 0%, #002B45 100%);
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: -.01em;
    cursor: pointer;
    transition: filter .15s, transform .15s;
    margin-top: .5rem;
}
.auth-submit:hover { filter: brightness(1.08); transform: translateY(-1px); }

.senha-req {
    font-size: .77rem;
    color: #94a3b8;
    margin-top: .3rem;
}

@@media (max-width: 480px) {
    .auth-card { padding: 1.75rem 1.25rem; }
    .auth-card-header h1 { font-size: 1.3rem; }
}
</style>
}

<div class="auth-shell">
    <div class="auth-card">

        <div class="auth-card-header">
            <h1>Nova senha</h1>
            <p>Escolha uma senha segura para a sua conta</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-alert auth-alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <div>
                    <div asp-validation-summary="All"></div>
                </div>
            </div>
        }

        <form asp-action="RedefinirSenha" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label">Nova senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="novaSenha" class="form-control"
                           placeholder="••••••••" autocomplete="new-password" required minlength="6" />
                </div>
                <p class="senha-req">Mínimo de 6 caracteres</p>
            </div>

            <div class="mb-4">
                <label class="form-label">Confirmar senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="confirmarSenha" class="form-control"
                           placeholder="••••••••" autocomplete="new-password" required minlength="6" />
                </div>
            </div>

            <button type="submit" class="auth-submit">
                Salvar nova senha
            </button>
        </form>

    </div>
</div>
