.mv-tl-icon.voo        { background: #dbeafe; color: var(--mv-voo); }
.mv-tl-icon.checkin    { background: #d1fae5; color: var(--mv-checkin); }
.mv-tl-icon.checkout   { background: #fee2e2; color: var(--mv-checkout); }
.mv-tl-icon.experiencia{ background: #ede9fe; color: var(--mv-exp); }
.mv-tl-icon.destino    { background: #cffafe; color: var(--mv-dest); }
.mv-tl-icon.transporte { background: #fef3c7; color: #d97706; }

.mv-tl-body {
    flex: 1;
    min-width: 0;
    padding-bottom: 14px;
}

.mv-tl-time {
    font-size: .7rem;
    font-weight: 700;
    color: var(--mv-muted);
    margin-bottom: 1px;
    letter-spacing: .04em;
}

.mv-tl-titulo {
    font-weight: 600;
    font-size: .9rem;
    line-height: 1.3;
}

.mv-tl-sub {
    font-size: .78rem;
    color: var(--mv-muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mv-tl-toggle {
    background: none;
    border: none;
    padding: 4px 0;
    font-size: .75rem;
    color: var(--mv-accent);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
