.mv-tl-detail .mv-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .78rem;
    font-weight: 600;
    color: var(--mv-accent);
    text-decoration: none;
    padding: 6px 10px;
    background: var(--mv-surface);
    border-radius: 8px;
