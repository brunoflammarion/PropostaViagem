@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = Model.Titulo;
}
@model SistemaUsuarios.Models.Proposta
@using SistemaUsuarios.Models

@functions {
    static string MvLighten(string hex, int amt)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith("#") || hex.Length != 7) return hex;
        try
        {
            int r = Math.Clamp(Convert.ToInt32(hex.Substring(1, 2), 16) + amt, 0, 255);
            int g = Math.Clamp(Convert.ToInt32(hex.Substring(3, 2), 16) + amt, 0, 255);
            int b = Math.Clamp(Convert.ToInt32(hex.Substring(5, 2), 16) + amt, 0, 255);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        catch { return hex; }
    }

    static string MvContrast(string hex)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith("#") || hex.Length != 7) return "#ffffff";
        try
        {
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return (0.299 * r + 0.587 * g + 0.114 * b) / 255.0 > 0.5 ? "#1a1a2e" : "#ffffff";
        }
        catch { return "#ffffff"; }
    }

    static string MvTint(string hex, double f = 0.91)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith("#") || hex.Length != 7) return "#f0f4f8";
        try
        {
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return $"#{(int)(r + (255 - r) * f):X2}{(int)(g + (255 - g) * f):X2}{(int)(b + (255 - b) * f):X2}";
        }
        catch { return "#f0f4f8"; }
    }

    static DateTime MvLocal(DateTime utc, TimeZoneInfo tz)
    {
        var adj = utc.TimeOfDay == TimeSpan.Zero ? utc.AddHours(12) : utc;
        return TimeZoneInfo.ConvertTimeFromUtc(adj, tz);
    }

    static string MvIcone(string tipo) => tipo switch
    {
        "voo"         => "fa-plane-departure",
        "checkin"     => "fa-bed",
        "checkout"    => "fa-sign-out-alt",
        "experiencia" => "fa-ticket-alt",
        "destino"     => "fa-map-marker-alt",
        "transporte"  => "fa-bus",
        _             => "fa-circle"
    };

    static string MvLabel(string tipo) => tipo switch
    {
        "voo"         => "Voo",
        "checkin"     => "Check-in",
        "checkout"    => "Check-out",
        "experiencia" => "Experiência",
        "destino"     => "Destino",
        "transporte"  => "Transporte",
        _             => ""
    };

    public class MvEvt
    {
        public string Tipo { get; set; } = "";
        public DateTime Dt { get; set; }
        public bool SoData { get; set; }
        public string Titulo { get; set; } = "";
        public string? Sub { get; set; }
        public string? Detalhe { get; set; }
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public string? FotoUrl { get; set; }
        public List<string> Arquivos { get; set; } = new();
        public List<string> ArquivosNomes { get; set; } = new();
        public string? Descricao { get; set; }
        public DateTime? DataFim { get; set; }
        public decimal? Valor { get; set; }
        public string? VideoUrl { get; set; }
        public List<string> Fotos { get; set; } = new();
    }
}

@{
    bool isSite = (bool)(ViewBag.IsSite ?? false);

    // ── Timezone ─────────────────────────────────────────────────────────────
    TimeZoneInfo brzTz;
    try { brzTz = TimeZoneInfo.FindSystemTimeZoneById("E. South America Standard Time"); }
    catch { try { brzTz = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo"); } catch { brzTz = TimeZoneInfo.Utc; } }

    var agora = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, brzTz);
    var hoje  = agora.Date;
    var ptBR  = new System.Globalization.CultureInfo("pt-BR");

    // ── Agente / agência ─────────────────────────────────────────────────────
    var agenteResp  = Model.UsuarioResponsavel ?? Model.Usuario;
    var nomeAgente  = agenteResp?.Nome ?? "agente";
    var fotoAgente  = agenteResp?.FotoPath ?? "";
    var nomeAgencia = Model.Usuario?.NomeAgencia ?? "";
    var logoUrl     = Model.Usuario?.LogoAgenciaPath ?? Model.Usuario?.UsuarioMaster?.LogoAgenciaPath ?? "";
    var waMsgRaw    = $"Olá! Estou com dúvidas sobre minha viagem \"{Model.Titulo}\". Pode me ajudar?";
    var waUrl       = WhatsAppHelper.MontarUrl(agenteResp?.Telefone, waMsgRaw);

    // ── Cores da marca ────────────────────────────────────────────────────────
    var corP    = !string.IsNullOrEmpty(Model.Usuario?.CorPrimaria) ? Model.Usuario.CorPrimaria : "#1c2e4a";
    var corD    = !string.IsNullOrEmpty(Model.Usuario?.CorDestaque) ? Model.Usuario.CorDestaque : "#3b82f6";
    var corPTxt = MvContrast(corP);
    var corDTxt = MvContrast(corD);
    var corTint = MvTint(corP, 0.93);
    var corDTint= MvTint(corD, 0.90);

    // ── Countdown ────────────────────────────────────────────────────────────
    var statusViagem   = "pre";
    int diasParaInicio = 0, diaAtual = 0, diasTotal = 0;

    if (Model.DataInicio.HasValue)
    {
        var dtI = Model.DataInicio.Value.Date;
        diasParaInicio = (dtI - hoje).Days;
        if (Model.DataFim.HasValue)
        {
            var dtF = Model.DataFim.Value.Date;
            diasTotal = (dtF - dtI).Days + 1;
            if      (hoje < dtI) statusViagem = "pre";
            else if (hoje > dtF) statusViagem = "pos";
            else { statusViagem = "durante"; diaAtual = (hoje - dtI).Days + 1; }
        }
        else
        {
            statusViagem = hoje < dtI ? "pre" : "durante";
        }
    }

    // ── Build DayByDay ────────────────────────────────────────────────────────
    var todos = new List<MvEvt>();

    // Voos
    foreach (var v in Model.Voos)
    {
        if (!v.HorarioSaida.HasValue) continue;
        var dtL = MvLocal(v.HorarioSaida.Value, brzTz);
        string? det = null;
        if (v.HorarioChegada.HasValue)
        {
            var chL = MvLocal(v.HorarioChegada.Value, brzTz);
            det = $"Chegada: {chL:dd/MM HH:mm}";
        }
        var sub = $"{v.Origem} → {v.Destino}".Trim();
        if (sub == "→") sub = "";
        var docs = new List<string>(); var docsNomes = new List<string>();
        foreach (var a in v.Anexos)
            if (!string.IsNullOrEmpty(a.CaminhoArquivo)) { docs.Add(a.CaminhoArquivo); docsNomes.Add(a.NomeOriginal ?? "Documento"); }
        todos.Add(new MvEvt { Tipo = "voo", Dt = dtL, SoData = v.HorarioSaida.Value.TimeOfDay == TimeSpan.Zero,
            Titulo = $"{v.Companhia} {v.NumeroVoo}".Trim(), Sub = sub.Length > 0 ? sub : null,
            Detalhe = det, Arquivos = docs, ArquivosNomes = docsNomes });
    }

    // Hospedagens
    foreach (var dest in Model.Destinos)
    {
        foreach (var h in dest.Hospedagens)
        {
            if (h.CheckIn.HasValue)
            {
                var dtL  = MvLocal(h.CheckIn.Value, brzTz);
                var foto = h.Fotos.FirstOrDefault(f => f.Principal)?.CaminhoFoto ?? h.Fotos.FirstOrDefault()?.CaminhoFoto;
                todos.Add(new MvEvt { Tipo = "checkin", Dt = dtL, SoData = h.CheckIn.Value.TimeOfDay == TimeSpan.Zero,
                    Titulo = $"Check-in: {h.Nome}", Sub = h.Endereco, Lat = h.Latitude, Lng = h.Longitude, FotoUrl = foto });
            }
            if (h.CheckOut.HasValue)
            {
                var dtL = MvLocal(h.CheckOut.Value, brzTz);
                todos.Add(new MvEvt { Tipo = "checkout", Dt = dtL, SoData = h.CheckOut.Value.TimeOfDay == TimeSpan.Zero,
                    Titulo = $"Check-out: {h.Nome}", Sub = h.Endereco, Lat = h.Latitude, Lng = h.Longitude });
            }
        }

        // Experiências
        foreach (var e in dest.Experiencias)
        {
            if (!e.DataInicio.HasValue) continue;
            var dtL    = MvLocal(e.DataInicio.Value, brzTz);
            var dtFimE = e.DataFim.HasValue ? (DateTime?)MvLocal(e.DataFim.Value, brzTz) : null;
            var fotosE = e.Imagens.OrderBy(i => i.Ordem).Select(i => i.CaminhoImagem).Where(u => !string.IsNullOrEmpty(u)).ToList();
            var fotoE  = fotosE.FirstOrDefault();
            var docsE  = new List<string>(); var docsNomE = new List<string>();
            foreach (var a in e.Arquivos)
                if (!string.IsNullOrEmpty(a.CaminhoArquivo)) { docsE.Add(a.CaminhoArquivo); docsNomE.Add(a.NomeOriginal ?? "Voucher"); }
            todos.Add(new MvEvt { Tipo = "experiencia", Dt = dtL, SoData = e.DataInicio.Value.TimeOfDay == TimeSpan.Zero,
                Titulo = e.TipoPasseio, Sub = dest.Nome, FotoUrl = fotoE, Arquivos = docsE, ArquivosNomes = docsNomE,
                Descricao = e.Descricao, DataFim = dtFimE, Valor = e.Valor, VideoUrl = e.VideoUrl, Fotos = fotosE });
        }
    }

    // Destinos — chegada (só se não houver check-in no mesmo dia)
    foreach (var d in Model.Destinos)
    {
        if (!d.DataChegada.HasValue) continue;
        var dtL    = MvLocal(d.DataChegada.Value, brzTz);
        var dtDate = dtL.Date;
        bool temCI = d.Hospedagens.Any(h => h.CheckIn.HasValue && MvLocal(h.CheckIn.Value, brzTz).Date == dtDate);
        if (temCI) continue;
        var foto = d.Fotos.FirstOrDefault(f => f.Principal)?.CaminhoFoto ?? d.Fotos.FirstOrDefault()?.CaminhoFoto;
        todos.Add(new MvEvt { Tipo = "destino", Dt = dtDate.AddHours(12), SoData = true,
            Titulo = $"Chegada: {d.Nome}", Sub = d.Pais, Lat = d.Latitude, Lng = d.Longitude, FotoUrl = foto });
    }

    // Agrupar por dia
    var porDia = todos
        .OrderBy(e => e.Dt)
        .GroupBy(e => e.Dt.Date)
        .Select(g => new { Date = g.Key, Evts = g.OrderBy(e => e.SoData ? 1 : 0).ThenBy(e => e.Dt).ToList() })
        .OrderBy(g => g.Date)
        .ToList();

    // Próximo evento
    var proximoEvt = todos
        .Where(e => e.SoData ? e.Dt.Date >= hoje : e.Dt > agora)
        .OrderBy(e => e.Dt)
        .FirstOrDefault();

    // Docs consolidados
    var todosArqs = new List<(string Nome, string Url, string Cat)>();
    foreach (var v in Model.Voos)
        foreach (var a in v.Anexos)
            if (!string.IsNullOrEmpty(a.CaminhoArquivo))
                todosArqs.Add((a.NomeOriginal ?? "Documento", a.CaminhoArquivo, $"Voo {v.Origem}→{v.Destino}"));
    foreach (var dest in Model.Destinos)
    {
        foreach (var e in dest.Experiencias)
            foreach (var a in e.Arquivos)
                if (!string.IsNullOrEmpty(a.CaminhoArquivo))
                    todosArqs.Add((a.NomeOriginal ?? "Voucher", a.CaminhoArquivo, e.TipoPasseio));
        foreach (var t in dest.Transportes)
            foreach (var a in t.Documentos)
                if (!string.IsNullOrEmpty(a.CaminhoArquivo))
                    todosArqs.Add((a.NomeOriginal ?? "Documento", a.CaminhoArquivo, t.Titulo));
    }
    foreach (var s in Model.Seguros)
        foreach (var a in s.Documentos)
            if (!string.IsNullOrEmpty(a.CaminhoArquivo))
                todosArqs.Add((a.NomeOriginal ?? "Apólice", a.CaminhoArquivo, s.Titulo));

    var todosTransportes = Model.Destinos.SelectMany(d => d.Transportes).ToList();
    var totalDestinos    = Model.Destinos.Count;
    var totalPax         = Model.PassageirosProposta.Count;

    // Formatação
    string FormatDate(DateTime? dt) => dt.HasValue ? dt.Value.ToString("dd 'de' MMMM", ptBR) : "";
    string FormatDay(DateTime dt)   => dt.ToString("ddd, dd MMM", ptBR);

    // ── Hero ─────────────────────────────────────────────────────────────────
    // Destino atual: mais recente com chegada <= hoje
    var destinoAtual = Model.Destinos
        .Where(d => d.DataChegada.HasValue && d.DataChegada.Value.Date <= hoje)
        .OrderByDescending(d => d.DataChegada!.Value)
        .FirstOrDefault()
        ?? Model.Destinos.OrderBy(d => d.DataChegada).FirstOrDefault();

    var destinoAtualNome = destinoAtual?.Nome ?? "";

    var heroFoto = !string.IsNullOrEmpty(Model.FotoCapa) ? Model.FotoCapa
        : destinoAtual?.Fotos.FirstOrDefault(f => f.Principal)?.CaminhoFoto
        ?? destinoAtual?.Fotos.FirstOrDefault()?.CaminhoFoto
        ?? Model.Destinos.SelectMany(d => d.Fotos).FirstOrDefault(f => f.Principal)?.CaminhoFoto
        ?? Model.Destinos.SelectMany(d => d.Fotos).FirstOrDefault()?.CaminhoFoto;

    var heroStyle = !string.IsNullOrEmpty(heroFoto)
        ? $"background-image:linear-gradient(to bottom,rgba(0,0,0,.22) 0%,rgba(0,0,0,.72) 100%),url({heroFoto});background-size:cover;background-position:center;"
        : "";

    // Data de hoje para JS
    var hojeStr = hoje.ToString("yyyyMMdd");

    // Há próximo e a viagem não acabou?
    bool hasProximo = proximoEvt != null && statusViagem != "pos";
}

<title>@Model.Titulo — Minha Viagem</title>

<style>
:root {
    --mv-primary:  @corP;
    --mv-accent:   @corD;
    --mv-ptxt:     @corPTxt;
    --mv-dtxt:     @corDTxt;
    --mv-tint:     @corTint;
    --mv-dtint:    @corDTint;
    --mv-surface:  #ffffff;
    --mv-surface2: #f8fafc;
    --mv-border:   #e2e8f0;
    --mv-text:     #1e293b;
    --mv-muted:    #64748b;
    --mv-header-h: 56px;
    --mv-nav-h:    64px;
    --mv-checkin:  #059669;
    --mv-voo:      #2563eb;
    --mv-exp:      #7c3aed;
    --mv-dest:     #0891b2;
    --mv-checkout: #dc2626;
}
* { box-sizing: border-box; }
body {
    background: var(--mv-surface2);
    color: var(--mv-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; padding: 0; overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ── HEADER ──────────────────────────────────────────────────────────────── */
.mv-header {
    position: fixed; top: 0; left: 0; right: 0;
    height: var(--mv-header-h); background: var(--mv-primary);
    z-index: 200; display: flex; align-items: center;
    padding: 0 14px; gap: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
}
.mv-logo { height: 30px; width: auto; object-fit: contain; border-radius: 4px; flex-shrink: 0; }
.mv-header-title {
    flex: 1; color: var(--mv-ptxt); font-size: .85rem; font-weight: 600;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: .92; min-width: 0;
}
.mv-wa-btn {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.15); display: flex; align-items: center;
    justify-content: center; color: var(--mv-ptxt); text-decoration: none;
    font-size: 18px; transition: background .2s;
}
.mv-wa-btn:hover { background: rgba(255,255,255,.28); color: var(--mv-ptxt); }

/* ── PANELS ──────────────────────────────────────────────────────────────── */
.mv-panels {
    margin-top: var(--mv-header-h);
    padding-bottom: calc(var(--mv-nav-h) + 12px);
    min-height: calc(100vh - var(--mv-header-h));
}
.mv-panel { display: none; }
.mv-panel.active { display: block; }
#panel-roteiro, #panel-viagem, #panel-docs { padding: 14px; }

/* ── HERO ────────────────────────────────────────────────────────────────── */
.mv-hero {
    height: 192px; display: flex; align-items: flex-end;
    position: relative; overflow: hidden;
    background: var(--mv-primary);
}
.mv-hero-body {
    position: relative; z-index: 1;
    padding: 18px 18px 20px; width: 100%;
}
.mv-hero-agency {
    font-size: .68rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: rgba(255,255,255,.7); margin-bottom: 5px;
}
.mv-hero-chip {
    display: inline-flex; align-items: center;
    font-size: .6rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: #fff;
    background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.22);
    border-radius: 20px; padding: 3px 10px; margin-bottom: 7px;
}
.mv-hero-main {
    font-size: 1.48rem; font-weight: 800; color: #fff;
    line-height: 1.15; margin-bottom: 5px;
    text-shadow: 0 1px 4px rgba(0,0,0,.3);
}
.mv-hero-date {
    font-size: .77rem; color: rgba(255,255,255,.75);
    text-transform: capitalize;
}

/* ── DAY PICKER ──────────────────────────────────────────────────────────── */
.mv-day-picker {
    position: sticky; top: var(--mv-header-h); z-index: 100;
    background: var(--mv-surface); border-bottom: 1px solid var(--mv-border);
    display: flex; gap: 4px; padding: 8px 12px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}
.mv-day-picker::-webkit-scrollbar { display: none; }

.mv-day-pill {
    flex-shrink: 0; scroll-snap-align: start;
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    min-width: 48px; padding: 6px 10px; border-radius: 20px;
    border: none; background: none; cursor: pointer;
    transition: background .15s, color .15s;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
}
.mv-dp-day { font-size: .9rem; font-weight: 700; color: var(--mv-text); line-height: 1.1; }
.mv-dp-dow { font-size: .56rem; font-weight: 600; letter-spacing: .05em; color: var(--mv-muted); }
.mv-day-pill.is-today .mv-dp-day { color: var(--mv-accent); }
.mv-day-pill.active { background: var(--mv-accent); }
.mv-day-pill.active .mv-dp-day,
.mv-day-pill.active .mv-dp-dow { color: var(--mv-dtxt); opacity: 1; }

/* ── PRÓXIMO STRIP ───────────────────────────────────────────────────────── */
.mv-prox-strip {
    display: flex; align-items: center; gap: 8px;
    margin: 12px 14px 0; padding: 9px 12px;
    background: var(--mv-dtint); border-radius: 12px;
    border-left: 3px solid var(--mv-accent);
}
.mv-prox-label {
    font-size: .56rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--mv-accent); flex-shrink: 0;
}
.mv-prox-icon { color: var(--mv-accent); font-size: .8rem; flex-shrink: 0; }
.mv-prox-titulo {
    flex: 1; font-size: .82rem; font-weight: 600; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mv-prox-quando {
    font-size: .78rem; font-weight: 700; color: var(--mv-accent);
    flex-shrink: 0; text-align: right; line-height: 1.3;
}

/* ── DAY PANE ────────────────────────────────────────────────────────────── */
.mv-day-pane { padding: 12px 14px 6px; }

/* ── HOSPEDAGEM BANNER ───────────────────────────────────────────────────── */
.mv-hosp-banner {
    display: flex; align-items: center; gap: 9px;
    background: #ecfdf5; border-radius: 10px; padding: 9px 12px;
    margin-bottom: 14px; border: 1px solid #a7f3d0;
}
.mv-hosp-banner i { color: #059669; font-size: .82rem; flex-shrink: 0; }
.mv-hosp-banner .mv-hosp-nome {
    flex: 1; font-size: .82rem; font-weight: 600; color: #065f46;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.mv-hosp-link {
    font-size: .73rem; font-weight: 700; color: #059669;
    text-decoration: none; flex-shrink: 0; display: flex; align-items: center; gap: 3px;
}

/* ── PERIOD SEPARATOR ────────────────────────────────────────────────────── */
.mv-period-sep {
    display: flex; align-items: center; gap: 8px;
    margin: 12px 0 8px;
}
.mv-period-sep::before, .mv-period-sep::after {
    content: ''; flex: 1; height: 1px; background: var(--mv-border);
}
.mv-period-sep span {
    font-size: .58rem; font-weight: 800; letter-spacing: .1em;
    color: var(--mv-muted); text-transform: uppercase;
}

/* ── TIMELINE ────────────────────────────────────────────────────────────── */
.mv-tl { display: flex; flex-direction: column; }

.mv-tl-item { display: flex; gap: 12px; position: relative; }
.mv-tl-item:not(:last-child) .mv-tl-line {
    position: absolute; left: 17px; top: 36px; bottom: 0;
    width: 2px; background: var(--mv-border);
}
.mv-tl-icon {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0; z-index: 1;
}
.mv-tl-icon.voo        { background: #dbeafe; color: var(--mv-voo); }
.mv-tl-icon.checkin    { background: #d1fae5; color: var(--mv-checkin); }
.mv-tl-icon.checkout   { background: #fee2e2; color: var(--mv-checkout); }
.mv-tl-icon.experiencia{ background: #ede9fe; color: var(--mv-exp); }
.mv-tl-icon.destino    { background: #cffafe; color: var(--mv-dest); }
.mv-tl-icon.transporte { background: #fef3c7; color: #d97706; }

.mv-tl-body { flex: 1; min-width: 0; padding-bottom: 14px; }
.mv-tl-time { font-size: .7rem; font-weight: 700; color: var(--mv-muted); margin-bottom: 1px; letter-spacing: .04em; }
.mv-tl-titulo { font-weight: 600; font-size: .9rem; line-height: 1.3; }
.mv-tl-sub { font-size: .78rem; color: var(--mv-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mv-tl-toggle {
    background: none; border: none; padding: 4px 0; font-size: .75rem;
    color: var(--mv-accent); cursor: pointer; display: flex;
    align-items: center; gap: 4px; font-weight: 600; margin-top: 4px;
    -webkit-tap-highlight-color: transparent;
}
.mv-tl-detail {
    background: var(--mv-tint); border-radius: 10px;
    padding: 10px 12px; margin-top: 8px;
    font-size: .8rem; line-height: 1.5;
}
.mv-tl-foto {
    width: 100%; max-height: 150px; object-fit: cover;
    border-radius: 10px; margin-top: 8px; display: block;
}
.mv-fotos-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 4px; margin: 8px 0; border-radius: 8px; overflow: hidden;
}
.mv-fotos-grid img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
.mv-det-row { display: flex; align-items: flex-start; gap: 7px; font-size: .8rem; color: var(--mv-muted); margin-bottom: 5px; }
.mv-det-row i { font-size: .76rem; width: 14px; flex-shrink: 0; margin-top: 2px; color: var(--mv-accent); }
.mv-det-row span { flex: 1; }
.mv-action {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .78rem; font-weight: 600; color: var(--mv-accent);
    text-decoration: none; padding: 6px 10px; background: var(--mv-surface);
    border-radius: 8px; margin: 6px 6px 0 0; border: 1px solid var(--mv-border);
}

/* Marcador "Próximo" inline */
.mv-prox-marker {
    font-size: .56rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--mv-accent); margin-bottom: 2px;
}

/* ── RICHTEXT ────────────────────────────────────────────────────────────── */
.mv-richtext p { margin: 0 0 .4rem; line-height: 1.55; }
.mv-richtext p:last-child { margin-bottom: 0; }
.mv-richtext strong, .mv-richtext b { font-weight: 700; }
.mv-richtext em { font-style: italic; }
.mv-richtext ul, .mv-richtext ol { padding-left: 1.3rem; margin: .3rem 0; }
.mv-richtext a { color: var(--mv-accent); }

/* ── CARDS ───────────────────────────────────────────────────────────────── */
.mv-card { background: var(--mv-surface); border-radius: 14px; border: 1px solid var(--mv-border); padding: 16px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.mv-card-label { font-size: .68rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--mv-muted); margin-bottom: 8px; }

/* ── AGENTE CARD ─────────────────────────────────────────────────────────── */
.mv-agente-card {
    background: var(--mv-primary); border-radius: 16px; padding: 16px;
    color: var(--mv-ptxt); display: flex; align-items: center; gap: 12px;
    margin: 16px 14px 0; text-decoration: none;
}
.mv-agente-foto { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,.3); flex-shrink: 0; }
.mv-agente-icon { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
.mv-agente-info { flex: 1; min-width: 0; }
.mv-agente-nome { font-weight: 700; font-size: .9rem; }
.mv-agente-sub  { font-size: .78rem; opacity: .8; }
.mv-agente-wa   { flex-shrink: 0; font-size: 22px; opacity: .9; }

/* ── SECTION TITLE ───────────────────────────────────────────────────────── */
.mv-section-title { font-size: .78rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--mv-muted); margin: 20px 0 10px; }

/* ── ROTEIRO ACCORDION ───────────────────────────────────────────────────── */
.mv-dia-acc { background: var(--mv-surface); border-radius: 14px; border: 1px solid var(--mv-border); margin-bottom: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
.mv-dia-acc.mv-dia-atual { border-color: var(--mv-accent); box-shadow: 0 0 0 1.5px var(--mv-accent), 0 2px 8px rgba(0,0,0,.07); }
.mv-dia-hdr { display: flex; align-items: center; gap: 10px; padding: 13px 14px; cursor: pointer; -webkit-tap-highlight-color: transparent; user-select: none; min-height: 58px; }
.mv-dia-hdr-left { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; }
.mv-dia-hdr-info { min-width: 0; }
.mv-dia-date { font-size: .85rem; font-weight: 600; color: var(--mv-text); line-height: 1.2; }
.mv-dia-count { font-size: .71rem; color: var(--mv-muted); margin-top: 2px; }
.mv-day-num { background: var(--mv-primary); color: var(--mv-ptxt); font-size: .65rem; font-weight: 700; padding: 2px 7px; border-radius: 20px; letter-spacing: .06em; text-transform: uppercase; flex-shrink: 0; }
.mv-day-hoje { background: var(--mv-accent); }
.mv-dia-chev { color: var(--mv-muted); font-size: .8rem; transition: transform .25s ease; flex-shrink: 0; }
.mv-dia-acc.open .mv-dia-chev { transform: rotate(180deg); }
.mv-dia-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease; }
.mv-dia-acc.open .mv-dia-body { grid-template-rows: 1fr; }
.mv-dia-inner { overflow: hidden; min-height: 0; }

/* ── DOCS ────────────────────────────────────────────────────────────────── */
.mv-doc-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: var(--mv-surface); border-radius: 12px; border: 1px solid var(--mv-border); margin-bottom: 8px; text-decoration: none; color: var(--mv-text); }
.mv-doc-icon { width: 36px; height: 36px; border-radius: 8px; background: var(--mv-dtint); color: var(--mv-accent); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.mv-doc-nome { font-size: .85rem; font-weight: 600; }
.mv-doc-cat  { font-size: .73rem; color: var(--mv-muted); margin-top: 1px; }
.mv-doc-arrow{ color: var(--mv-muted); font-size: .8rem; flex-shrink: 0; }

/* ── DESTINO ITEM ────────────────────────────────────────────────────────── */
.mv-destino-item { background: var(--mv-surface); border-radius: 14px; border: 1px solid var(--mv-border); padding: 14px; margin-bottom: 10px; }
.mv-destino-nome { font-weight: 700; font-size: 1rem; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
.mv-destino-meta { font-size: .78rem; color: var(--mv-muted); }

/* ── EMPTY STATE ─────────────────────────────────────────────────────────── */
.mv-empty { text-align: center; padding: 40px 20px; color: var(--mv-muted); font-size: .88rem; }
.mv-empty i { font-size: 32px; margin-bottom: 8px; display: block; opacity: .4; }

/* ── BOTTOM NAV ──────────────────────────────────────────────────────────── */
.mv-nav { position: fixed; bottom: 0; left: 0; right: 0; height: var(--mv-nav-h); background: var(--mv-surface); border-top: 1px solid var(--mv-border); display: flex; z-index: 200; padding-bottom: env(safe-area-inset-bottom, 0px); }
.mv-nav-btn { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; font-size: .65rem; font-weight: 500; color: var(--mv-muted); background: none; border: none; cursor: pointer; padding: 6px 0; letter-spacing: .01em; transition: color .18s; -webkit-tap-highlight-color: transparent; }
.mv-nav-btn i { font-size: 20px; }
.mv-nav-btn.active { color: var(--mv-accent); }
.mv-nav-btn.active i { font-weight: 900; }

/* ── DESKTOP ─────────────────────────────────────────────────────────────── */
@@media (min-width: 640px) {
    .mv-header, .mv-nav {
        left: max(0px, calc(50vw - 300px));
        right: max(0px, calc(50vw - 300px));
        width: auto;
    }
    .mv-day-picker {
        left: max(0px, calc(50vw - 300px));
        right: max(0px, calc(50vw - 300px));
        width: auto;
    }
    .mv-panels { max-width: 600px; margin-left: auto; margin-right: auto; }
    .mv-header { border-radius: 0 0 12px 12px; }
    .mv-hero { height: 220px; }
}
</style>

@* ── TOP HEADER ───────────────────────────────────────────────────────────── *@
<div class="mv-header">
    @if (!string.IsNullOrEmpty(logoUrl))
    {
        <img src="@logoUrl" class="mv-logo" alt="@nomeAgencia" />
    }
    else if (!string.IsNullOrEmpty(nomeAgencia))
    {
        <span style="color:var(--mv-ptxt);font-weight:700;font-size:.8rem;opacity:.9;flex-shrink:0;">@nomeAgencia</span>
    }
    <span class="mv-header-title">@Model.Titulo</span>
    @if (!string.IsNullOrEmpty(waUrl))
    {
        <a href="@waUrl" class="mv-wa-btn" title="Falar com agente">
            <i class="fab fa-whatsapp"></i>
        </a>
    }
</div>

<div class="mv-panels">

    @* ═══ PANEL: HOJE ════════════════════════════════════════════════════════ *@
    <div id="panel-hoje" class="mv-panel active">

        @* Hero *@
        <div class="mv-hero" style="@heroStyle">
            <div class="mv-hero-body">
                <div class="mv-hero-agency">
                    @(!string.IsNullOrEmpty(nomeAgencia) ? nomeAgencia : "Minha Viagem")
                </div>
                @if (statusViagem == "pre" && Model.DataInicio.HasValue)
                {
                    @if (diasParaInicio > 1)
                    {
                        <div class="mv-hero-chip">CONTAGEM REGRESSIVA</div>
                        <div class="mv-hero-main">Faltam @diasParaInicio dias</div>
                    }
                    else if (diasParaInicio == 1)
                    {
                        <div class="mv-hero-chip">AMANHÃ</div>
                        <div class="mv-hero-main">Sua viagem começa amanhã</div>
                    }
                    else
                    {
                        <div class="mv-hero-chip">HOJE ✈</div>
                        <div class="mv-hero-main">Sua viagem começa hoje!</div>
                    }
                }
                else if (statusViagem == "durante")
                {
                    @if (diasTotal > 0)
                    {
                        <div class="mv-hero-chip">DIA @diaAtual DE @diasTotal</div>
                    }
                    <div class="mv-hero-main">
                        @(!string.IsNullOrEmpty(destinoAtualNome) ? destinoAtualNome : Model.Titulo)
                    </div>
                }
                else if (statusViagem == "pos")
                {
                    <div class="mv-hero-chip">VIAGEM REALIZADA</div>
                    <div class="mv-hero-main">@Model.Titulo</div>
                }
                else
                {
                    <div class="mv-hero-main">@Model.Titulo</div>
                }
                <div class="mv-hero-date">@hoje.ToString("dd 'de' MMMM, dddd", ptBR)</div>
            </div>
        </div>

        @* Day Picker *@
        @if (porDia.Count > 0)
        {
            <div class="mv-day-picker" id="mvDayPicker">
                @foreach (var dia in porDia)
                {
                    bool isDiaHojeBtn = dia.Date == hoje;
                    string dateKey2   = dia.Date.ToString("yyyyMMdd");
                    <button class="mv-day-pill @(isDiaHojeBtn ? "is-today" : "")"
                            data-date="@dateKey2"
                            onclick="mvSelectDay('@dateKey2',this)">
                        <span class="mv-dp-day">@dia.Date.Day</span>
                        <span class="mv-dp-dow">@dia.Date.ToString("ddd", ptBR).ToUpper().Substring(0, 3)</span>
                    </button>
                }
            </div>
        }

        @* Próximo compromisso (visível apenas quando o dia selecionado = hoje) *@
        @if (hasProximo)
        {
            <div class="mv-prox-strip" id="mvProxStrip" style="display:none;">
                <div class="mv-prox-label">Próximo</div>
                <div class="mv-prox-icon"><i class="fas @MvIcone(proximoEvt!.Tipo)"></i></div>
                <div class="mv-prox-titulo">@proximoEvt!.Titulo</div>
                <div class="mv-prox-quando">
                    @if (proximoEvt.SoData)
                    {
                        @proximoEvt.Dt.ToString("dd/MM", ptBR)
                    }
                    else if (proximoEvt.Dt.Date == hoje)
                    {
                        @proximoEvt.Dt.ToString("HH:mm")
                    }
                    else
                    {
                        @proximoEvt.Dt.ToString("dd/MM", ptBR)<br />@proximoEvt.Dt.ToString("HH:mm")
                    }
                </div>
            </div>
        }

        @* Day panes — um por dia, JS mostra o selecionado *@
        @if (porDia.Count == 0)
        {
            <div class="mv-day-pane" style="display:block;">
                <div class="mv-empty">
                    <i class="fas fa-calendar-alt"></i>
                    Nenhum evento agendado ainda.
                </div>
            </div>
        }
        else
        {
            @foreach (var dia in porDia)
            {
                string dateKey = dia.Date.ToString("yyyyMMdd");
                bool isDiaHojePane = dia.Date == hoje;
                var hospAtiva = Model.Destinos
                    .SelectMany(d => d.Hospedagens)
                    .FirstOrDefault(h =>
                        h.CheckIn.HasValue && h.CheckOut.HasValue &&
                        h.CheckIn.Value.Date <= dia.Date &&
                        h.CheckOut.Value.Date >= dia.Date);
                var evtsSorted = dia.Evts;
                bool temHorario2 = evtsSorted.Any(e => !e.SoData);
                int periodoCount =
                    (evtsSorted.Any(e => e.SoData || (!e.SoData && e.Dt.Hour < 12)) ? 1 : 0) +
                    (evtsSorted.Any(e => !e.SoData && e.Dt.Hour >= 12 && e.Dt.Hour < 18) ? 1 : 0) +
                    (evtsSorted.Any(e => !e.SoData && e.Dt.Hour >= 18) ? 1 : 0);
                bool showPeriods = temHorario2 && periodoCount >= 2;
                bool inManha = false, inTarde = false, inNoite = false;
                int evtIdx2 = 0;

                <div class="mv-day-pane" data-date="@dateKey" style="display:none;">

                    @if (hospAtiva != null)
                    {
                        <div class="mv-hosp-banner">
                            <i class="fas fa-bed"></i>
                            <span class="mv-hosp-nome">@hospAtiva.Nome</span>
                            @if (hospAtiva.Latitude.HasValue && hospAtiva.Longitude.HasValue)
                            {
                                <a href="https://maps.google.com/?q=@hospAtiva.Latitude,@hospAtiva.Longitude"
                                   target="_blank" class="mv-hosp-link">
                                    <i class="fas fa-map-marker-alt"></i> Mapa
                                </a>
                            }
                        </div>
                    }

                    <div class="mv-tl">
                        @{
                            foreach (var evt in evtsSorted)
                            {
                                evtIdx2++;
                                string detId2   = $"mvp2-{dateKey}-{evtIdx2}";
                                bool isExp2     = evt.Tipo == "experiencia";
                                bool temDesc2   = !string.IsNullOrEmpty(evt.Descricao);
                                bool temFotos2  = evt.Fotos.Count > 1;
                                bool temValor2  = evt.Valor.HasValue;
                                bool temFim2    = evt.DataFim.HasValue && !evt.SoData;
                                bool temMapa2   = evt.Lat.HasValue && evt.Lng.HasValue;
                                bool temDocs2   = evt.Arquivos.Count > 0;
                                bool temDet2    = !string.IsNullOrEmpty(evt.Detalhe);
                                bool temRich2   = isExp2 && (temDesc2 || temFotos2 || temValor2 || temFim2 || temDocs2 || temMapa2);
                                bool temToggle2 = temRich2 || (!isExp2 && (temDocs2 || temMapa2 || temDet2));
                                bool isProximo  = isDiaHojePane && proximoEvt != null &&
                                    evt.Tipo   == proximoEvt.Tipo &&
                                    evt.Titulo == proximoEvt.Titulo &&
                                    evt.Dt     == proximoEvt.Dt;
                                string? periodSep = null;
                                if (showPeriods)
                                {
                                    string periodoEvt = (evt.SoData || evt.Dt.Hour < 12) ? "manha"
                                        : evt.Dt.Hour < 18 ? "tarde" : "noite";
                                    if      (periodoEvt == "manha" && !inManha) { inManha = true;  periodSep = "Manhã"; }
                                    else if (periodoEvt == "tarde" && !inTarde) { inTarde = true;  periodSep = "Tarde"; }
                                    else if (periodoEvt == "noite" && !inNoite) { inNoite = true;  periodSep = "Noite"; }
                                }
                                // Precompute loop data (avoid inline @for with var declarations)
                                var fotosExtra = evt.Fotos.Skip(1).Take(6).ToList();
                                var arqPairs   = evt.Arquivos.Select((u, i) =>
                                    (url: u, nome: i < evt.ArquivosNomes.Count ? evt.ArquivosNomes[i] : "Documento")).ToList();

                                if (periodSep != null)
                                {
                                    <div class="mv-period-sep"><span>@periodSep</span></div>
                                }
                                <div class="mv-tl-item">
                                    <div class="mv-tl-line"></div>
                                    <div class="mv-tl-icon @evt.Tipo">
                                        <i class="fas @MvIcone(evt.Tipo)"></i>
                                    </div>
                                    <div class="mv-tl-body">
                                        @if (isProximo)  { <div class="mv-prox-marker">Próximo</div> }
                                        @if (!evt.SoData) { <div class="mv-tl-time">@evt.Dt.ToString("HH:mm")</div> }
                                        <div class="mv-tl-titulo">@evt.Titulo</div>
                                        @if (!string.IsNullOrEmpty(evt.Sub)) { <div class="mv-tl-sub">@evt.Sub</div> }
                                        @if (!string.IsNullOrEmpty(evt.FotoUrl) && (isExp2 || evt.Tipo == "checkin") && !temRich2)
                                        {
                                            <img src="@evt.FotoUrl" class="mv-tl-foto" loading="lazy" alt="@evt.Titulo" />
                                        }
                                        @if (temToggle2)
                                        {
                                            <button class="mv-tl-toggle" onclick="mvToggleDet('@detId2',this)">
                                                <i class="fas fa-chevron-down"></i><span> Ver detalhes</span>
                                            </button>
                                            <div id="@detId2" class="mv-tl-detail" style="display:none;">
                                                @if (!string.IsNullOrEmpty(evt.FotoUrl) && isExp2)
                                                {
                                                    <img src="@evt.FotoUrl" class="mv-tl-foto" loading="lazy" alt="@evt.Titulo" style="margin-bottom:10px;" />
                                                }
                                                @if (temDesc2)
                                                {
                                                    <div class="mv-richtext" style="font-size:.82rem;margin-bottom:10px;">@Html.Raw(evt.Descricao)</div>
                                                }
                                                @if (temFim2)
                                                {
                                                    <div class="mv-det-row">
                                                        <i class="fas fa-hourglass-end"></i>
                                                        <span>Término: @evt.DataFim!.Value.ToString("HH:mm")</span>
                                                    </div>
                                                }
                                                @if (temValor2)
                                                {
                                                    <div class="mv-det-row">
                                                        <i class="fas fa-tag"></i>
                                                        <span>R$ @evt.Valor!.Value.ToString("N2", ptBR)</span>
                                                    </div>
                                                }
                                                @if (temDet2 && !isExp2)
                                                {
                                                    <div class="mv-det-row">
                                                        <i class="fas fa-info-circle"></i>
                                                        <span>@evt.Detalhe</span>
                                                    </div>
                                                }
                                                @if (temFotos2)
                                                {
                                                    <div class="mv-fotos-grid">
                                                        @foreach (var fUrl in fotosExtra)
                                                        {
                                                            <img src="@fUrl" loading="lazy" alt="" />
                                                        }
                                                    </div>
                                                }
                                                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                                                    @if (temMapa2)
                                                    {
                                                        <a href="https://maps.google.com/?q=@evt.Lat,@evt.Lng" target="_blank" class="mv-action">
                                                            <i class="fas fa-map-marker-alt"></i> Mapa
                                                        </a>
                                                    }
                                                    @foreach (var (arqUrl2, arqNome2) in arqPairs)
                                                    {
                                                        <a href="@arqUrl2" target="_blank" class="mv-action">
                                                            <i class="fas fa-file-alt"></i> @arqNome2
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                </div>
            }
        }

        @* Agente card *@
        @if (!string.IsNullOrEmpty(waUrl))
        {
            <a href="@waUrl" class="mv-agente-card">
                @if (!string.IsNullOrEmpty(fotoAgente))
                {
                    <img src="@fotoAgente" class="mv-agente-foto" alt="@nomeAgente" />
                }
                else
                {
                    <div class="mv-agente-icon"><i class="fas fa-user-tie"></i></div>
                }
                <div class="mv-agente-info">
                    <div class="mv-agente-nome">@nomeAgente</div>
                    <div class="mv-agente-sub">Falar pelo WhatsApp</div>
                </div>
                <i class="fab fa-whatsapp mv-agente-wa"></i>
            </a>
        }

    </div>

    @* ═══ PANEL: ROTEIRO ══════════════════════════════════════════════════════ *@
    <div id="panel-roteiro" class="mv-panel">
        @if (porDia.Count == 0)
        {
            <div class="mv-empty">
                <i class="fas fa-route"></i>
                Nenhum evento com data cadastrado ainda.
            </div>
        }
        else
        {
            int diaNum = 0;
            @foreach (var dia in porDia)
            {
                diaNum++;
                bool isHoje = dia.Date == hoje;
                int numDia  = Model.DataInicio.HasValue ? (dia.Date - Model.DataInicio.Value.Date).Days + 1 : diaNum;
                string diaId = $"mvd-{dia.Date:yyyyMMdd}";
                int nEvts = dia.Evts.Count;

                <div class="mv-dia-acc @(isHoje ? "mv-dia-atual" : "")" id="@diaId">
                    <div class="mv-dia-hdr" onclick="mvToggleDia('@diaId')">
                        <div class="mv-dia-hdr-left">
                            <span class="mv-day-num @(isHoje ? "mv-day-hoje" : "")">
                                @(isHoje ? "HOJE" : $"DIA {numDia}")
                            </span>
                            <div class="mv-dia-hdr-info">
                                <div class="mv-dia-date">@FormatDay(dia.Date)</div>
                                <div class="mv-dia-count">@nEvts @(nEvts == 1 ? "evento" : "eventos")</div>
                            </div>
                        </div>
                        <i class="fas fa-chevron-down mv-dia-chev"></i>
                    </div>
                    <div class="mv-dia-body">
                        <div class="mv-dia-inner">
                            <div class="mv-tl" style="padding:4px 14px 14px;">
                                @{ int evtIdx = 0; }
                                @foreach (var evt in dia.Evts)
                                {
                                    evtIdx++;
                                    string detId = $"mvdet-{dia.Date:yyyyMMdd}-{evtIdx}";
                                    bool isExp    = evt.Tipo == "experiencia";
                                    bool temDesc  = !string.IsNullOrEmpty(evt.Descricao);
                                    bool temFotos = evt.Fotos.Count > 1;
                                    bool temValor = evt.Valor.HasValue;
                                    bool temFim   = evt.DataFim.HasValue && !evt.SoData;
                                    bool temMapa  = evt.Lat.HasValue && evt.Lng.HasValue;
                                    bool temDocs  = evt.Arquivos.Count > 0;
                                    bool temDetS  = !string.IsNullOrEmpty(evt.Detalhe);
                                    bool temRich  = isExp && (temDesc || temFotos || temValor || temFim || temDocs || temMapa);
                                    bool temToggle = temRich || (!isExp && (temDocs || temMapa || temDetS));

                                    <div class="mv-tl-item">
                                        <div class="mv-tl-line"></div>
                                        <div class="mv-tl-icon @evt.Tipo">
                                            <i class="fas @MvIcone(evt.Tipo)"></i>
                                        </div>
                                        <div class="mv-tl-body">
                                            @if (!evt.SoData) { <div class="mv-tl-time">@evt.Dt.ToString("HH:mm")</div> }
                                            <div class="mv-tl-titulo">@evt.Titulo</div>
                                            @if (!string.IsNullOrEmpty(evt.Sub)) { <div class="mv-tl-sub">@evt.Sub</div> }
                                            @if (!string.IsNullOrEmpty(evt.FotoUrl) && (isExp || evt.Tipo == "checkin") && !temRich)
                                            {
                                                <img src="@evt.FotoUrl" class="mv-tl-foto" loading="lazy" alt="@evt.Titulo" />
                                            }
                                            @if (temToggle)
                                            {
                                                <button class="mv-tl-toggle" onclick="mvToggleDet('@detId',this)">
                                                    <i class="fas fa-chevron-down"></i><span> Ver detalhes</span>
                                                </button>
                                                <div id="@detId" class="mv-tl-detail" style="display:none;">
                                                    @if (!string.IsNullOrEmpty(evt.FotoUrl) && isExp)
                                                    {
                                                        <img src="@evt.FotoUrl" class="mv-tl-foto" loading="lazy" alt="@evt.Titulo" style="margin-bottom:10px;" />
                                                    }
                                                    @if (temDesc) { <div class="mv-richtext" style="font-size:.82rem;margin-bottom:10px;">@Html.Raw(evt.Descricao)</div> }
                                                    @if (temFim) { <div class="mv-det-row"><i class="fas fa-hourglass-end"></i><span>Término: @evt.DataFim!.Value.ToString("HH:mm")</span></div> }
                                                    @if (temValor) { <div class="mv-det-row"><i class="fas fa-tag"></i><span>R$ @evt.Valor!.Value.ToString("N2", ptBR)</span></div> }
                                                    @if (temDetS && !isExp) { <div class="mv-det-row"><i class="fas fa-info-circle"></i><span>@evt.Detalhe</span></div> }
                                                    @if (temFotos)
                                                    {
                                                        <div class="mv-fotos-grid">
                                                            @foreach (var fUrl in evt.Fotos.Skip(1).Take(6)) { <img src="@fUrl" loading="lazy" alt="" /> }
                                                        </div>
                                                    }
                                                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                                                        @if (temMapa) { <a href="https://maps.google.com/?q=@evt.Lat,@evt.Lng" target="_blank" class="mv-action"><i class="fas fa-map-marker-alt"></i> Mapa</a> }
                                                        @for (int ai = 0; ai < evt.Arquivos.Count; ai++)
                                                        {
                                                            var arqUrl = evt.Arquivos[ai];
                                                            var arqNome = ai < evt.ArquivosNomes.Count ? evt.ArquivosNomes[ai] : "Documento";
                                                            <a href="@arqUrl" target="_blank" class="mv-action"><i class="fas fa-file-alt"></i> @arqNome</a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @* ═══ PANEL: VIAGEM ═══════════════════════════════════════════════════════ *@
    <div id="panel-viagem" class="mv-panel">

        <div class="mv-card">
            <div class="mv-card-label">INFORMAÇÕES GERAIS</div>
            <div style="display:flex;flex-wrap:wrap;gap:16px;">
                @if (totalDestinos > 0)
                {
                    <div>
                        <div style="font-size:.7rem;color:var(--mv-muted);font-weight:600;letter-spacing:.04em;text-transform:uppercase;">Destinos</div>
                        <div style="font-weight:700;font-size:1.1rem;">@totalDestinos</div>
                    </div>
                }
                @if (totalPax > 0)
                {
                    <div>
                        <div style="font-size:.7rem;color:var(--mv-muted);font-weight:600;letter-spacing:.04em;text-transform:uppercase;">Passageiros</div>
                        <div style="font-weight:700;font-size:1.1rem;">@totalPax</div>
                    </div>
                }
                @if (diasTotal > 0)
                {
                    <div>
                        <div style="font-size:.7rem;color:var(--mv-muted);font-weight:600;letter-spacing:.04em;text-transform:uppercase;">Duração</div>
                        <div style="font-weight:700;font-size:1.1rem;">@diasTotal dias</div>
                    </div>
                }
            </div>
            @if (!isSite && !string.IsNullOrWhiteSpace(Model.ObservacoesGerais))
            {
                <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--mv-border);font-size:.83rem;color:var(--mv-muted);white-space:pre-wrap;">@Model.ObservacoesGerais</div>
            }
        </div>

        @if (Model.Destinos.Count > 0)
        {
            <div class="mv-section-title">Destinos</div>
            @foreach (var d in Model.Destinos)
            {
                var fotoD = d.Fotos.FirstOrDefault(f => f.Principal)?.CaminhoFoto ?? d.Fotos.FirstOrDefault()?.CaminhoFoto;
                <div class="mv-destino-item">
                    @if (!string.IsNullOrEmpty(fotoD))
                    {
                        <img src="@fotoD" style="width:100%;height:120px;object-fit:cover;border-radius:10px;margin-bottom:10px;" loading="lazy" />
                    }
                    <div class="mv-destino-nome">
                        <i class="fas fa-map-marker-alt" style="color:var(--mv-accent);font-size:.85rem;"></i>
                        @d.Nome
                        @if (!string.IsNullOrEmpty(d.Pais)) { <span style="font-weight:400;color:var(--mv-muted);font-size:.85rem;">· @d.Pais</span> }
                    </div>
                    <div class="mv-destino-meta">
                        @if (d.DataChegada.HasValue) { <text>Chegada: @FormatDate(d.DataChegada)  </text> }
                        @if (d.DataSaida.HasValue) { <text>· Saída: @FormatDate(d.DataSaida)</text> }
                    </div>
                    @foreach (var h in d.Hospedagens)
                    {
                        <div style="margin-top:8px;padding:8px;background:var(--mv-tint);border-radius:8px;font-size:.8rem;">
                            <i class="fas fa-bed" style="color:var(--mv-checkin);margin-right:4px;"></i>
                            <strong>@h.Nome</strong>
                            @if (h.CheckIn.HasValue || h.CheckOut.HasValue)
                            {
                                <span style="color:var(--mv-muted);margin-left:6px;">
                                    @(h.CheckIn.HasValue ? h.CheckIn.Value.ToString("dd/MM") : "") – @(h.CheckOut.HasValue ? h.CheckOut.Value.ToString("dd/MM") : "")
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        }

        @if (!isSite && Model.PassageirosProposta.Count > 0)
        {
            <div class="mv-section-title">Passageiros</div>
            <div class="mv-card" style="padding:12px 14px;">
                @foreach (var p in Model.PassageirosProposta)
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:8px 0;@(p != Model.PassageirosProposta.Last() ? "border-bottom:1px solid var(--mv-border);" : "")">
                        <div style="width:34px;height:34px;border-radius:50%;background:var(--mv-dtint);display:flex;align-items:center;justify-content:center;color:var(--mv-accent);font-size:14px;flex-shrink:0;">
                            <i class="fas fa-user"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;font-size:.87rem;">@p.Nome</div>
                            @if (p.IsTitular) { <div style="font-size:.72rem;color:var(--mv-accent);font-weight:600;">Titular</div> }
                        </div>
                    </div>
                }
            </div>
        }

        @if (todosTransportes.Count > 0)
        {
            <div class="mv-section-title">Transportes</div>
            @foreach (var t in todosTransportes)
            {
                <div class="mv-card" style="padding:12px 14px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:36px;height:36px;border-radius:8px;background:#fef3c7;color:#d97706;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;">
                            <i class="fas fa-bus"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;font-size:.88rem;">@t.Titulo</div>
                        </div>
                    </div>
                    @foreach (var doc in t.Documentos)
                    {
                        if (!string.IsNullOrEmpty(doc.CaminhoArquivo))
                        {
                            <a href="@doc.CaminhoArquivo" target="_blank" style="display:inline-flex;align-items:center;gap:5px;margin-top:8px;font-size:.78rem;color:var(--mv-accent);font-weight:600;">
                                <i class="fas fa-file-alt"></i> @(doc.NomeOriginal ?? "Documento")
                            </a>
                        }
                    }
                </div>
            }
        }

    </div>

    @* ═══ PANEL: DOCS ═════════════════════════════════════════════════════════ *@
    <div id="panel-docs" class="mv-panel">
        @if (todosArqs.Count == 0)
        {
            <div class="mv-empty">
                <i class="fas fa-folder-open"></i>
                Nenhum documento cadastrado ainda.
            </div>
        }
        else
        {
            <p style="font-size:.8rem;color:var(--mv-muted);margin-bottom:14px;">Todos os seus documentos e vouchers em um só lugar.</p>
            @foreach (var (nome, url, cat) in todosArqs)
            {
                <a href="@url" target="_blank" class="mv-doc-item">
                    <div class="mv-doc-icon"><i class="fas fa-file-alt"></i></div>
                    <div style="flex:1;min-width:0;">
                        <div class="mv-doc-nome">@nome</div>
                        <div class="mv-doc-cat">@cat</div>
                    </div>
                    <i class="fas fa-external-link-alt mv-doc-arrow"></i>
                </a>
            }
        }
    </div>

</div>

@* ── BOTTOM NAV ────────────────────────────────────────────────────────────── *@
<nav class="mv-nav">
    <button class="mv-nav-btn active" data-panel="hoje" onclick="switchPanel('hoje',this)">
        <i class="fas fa-home"></i>
        <span>Hoje</span>
    </button>
    <button class="mv-nav-btn" data-panel="roteiro" onclick="switchPanel('roteiro',this)">
        <i class="fas fa-route"></i>
        <span>Roteiro</span>
    </button>
    <button class="mv-nav-btn" data-panel="viagem" onclick="switchPanel('viagem',this)">
        <i class="fas fa-globe-americas"></i>
        <span>Viagem</span>
    </button>
    <button class="mv-nav-btn" data-panel="docs" onclick="switchPanel('docs',this)">
        <i class="fas fa-folder-open"></i>
        <span>Docs</span>
        @if (todosArqs.Count > 0)
        {
            <span style="font-size:.6rem;background:var(--mv-accent);color:var(--mv-dtxt);border-radius:10px;padding:1px 5px;font-weight:700;line-height:1.4;margin-top:-2px;">@todosArqs.Count</span>
        }
    </button>
</nav>

<script>
(function () {
    var hojeStr    = '@hojeStr';
    var hasProximo = @(hasProximo ? "true" : "false");
    var status     = '@statusViagem';

    // ── Trocar painel ─────────────────────────────────────────────────────────
    function switchPanel(id, btn) {
        document.querySelectorAll('.mv-panel').forEach(function (p) { p.classList.remove('active'); });
        document.querySelectorAll('.mv-nav-btn').forEach(function (b) { b.classList.remove('active'); });
        var panel = document.getElementById('panel-' + id);
        if (panel) panel.classList.add('active');
        if (btn) btn.classList.add('active');
        window.scrollTo(0, 0);
        if (id === 'roteiro') {
            setTimeout(function () {
                var hoje = document.querySelector('#panel-roteiro .mv-dia-acc.mv-dia-atual');
                if (hoje) hoje.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 60);
        }
    }
    window.switchPanel = switchPanel;

    // ── Selecionar dia no picker ──────────────────────────────────────────────
    function mvSelectDay(dateStr, btn) {
        document.querySelectorAll('#panel-hoje .mv-day-pane').forEach(function (p) {
            p.style.display = 'none';
        });
        var pane = document.querySelector('#panel-hoje .mv-day-pane[data-date="' + dateStr + '"]');
        if (pane) pane.style.display = 'block';

        document.querySelectorAll('#mvDayPicker .mv-day-pill').forEach(function (p) {
            p.classList.remove('active');
        });
        if (btn) btn.classList.add('active');

        var proxStrip = document.getElementById('mvProxStrip');
        if (proxStrip && hasProximo) {
            proxStrip.style.display = dateStr === hojeStr ? 'flex' : 'none';
        }
    }
    window.mvSelectDay = mvSelectDay;

    // ── Accordion do roteiro ──────────────────────────────────────────────────
    function mvToggleDia(id) {
        var acc = document.getElementById(id);
        if (acc) acc.classList.toggle('open');
    }
    window.mvToggleDia = mvToggleDia;

    // ── Expand inline na timeline ─────────────────────────────────────────────
    function mvToggleDet(id, btn) {
        var el = document.getElementById(id);
        if (!el) return;
        var open = el.style.display === 'block';
        el.style.display = open ? 'none' : 'block';
        var icon = btn.querySelector('i');
        if (icon) icon.style.transform = open ? '' : 'rotate(180deg)';
        var span = btn.querySelector('span');
        if (span) span.textContent = open ? ' Ver detalhes' : ' Fechar';
    }
    window.mvToggleDet = mvToggleDet;

    // ── Inicialização ─────────────────────────────────────────────────────────
    (function init() {
        var picker = document.getElementById('mvDayPicker');
        if (!picker) return;

        // Selecionar dia inicial
        var todayBtn = picker.querySelector('[data-date="' + hojeStr + '"]');
        if (todayBtn) {
            mvSelectDay(hojeStr, todayBtn);
            // Centralizar pill de hoje
            setTimeout(function () {
                todayBtn.scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'center' });
            }, 0);
        } else {
            var pills = picker.querySelectorAll('.mv-day-pill');
            if (pills.length > 0) {
                var target = status === 'pos' ? pills[pills.length - 1] : pills[0];
                mvSelectDay(target.dataset.date, target);
            }
        }

        // Accordion do roteiro: abrir dia de hoje
        var atual = document.querySelector('.mv-dia-acc.mv-dia-atual');
        if (atual) atual.classList.add('open');
        else {
            var primeiro = document.querySelector('.mv-dia-acc');
            if (primeiro) primeiro.classList.add('open');
        }
    })();
})();
</script>
