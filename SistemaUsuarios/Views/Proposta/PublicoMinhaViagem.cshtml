    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--mv-muted);
    margin: 20px 0 10px;
}

/* ── AGENTE CARD ─────────────────────────────────────────────────────────── */
